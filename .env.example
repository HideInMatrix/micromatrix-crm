# MicroMatrix CRM Release 环境变量示例
# 对应根目录 docker-compose.release.yml
# 部署时复制为 .env：cp .env.example .env

# -----------------------------------------------------------------------------
# 镜像
# -----------------------------------------------------------------------------

# GitHub Release Tag / 镜像版本。
# 例如发布 v0.0.2 后设置为 v0.0.2。
APP_VERSION=v0.0.2

# 可选：覆盖默认 GHCR 镜像地址。
# 如果使用官方仓库，可以保留下面的默认值。
API_IMAGE=ghcr.io/hideinmatrix/micromatrix-crm-api:v0.0.2
MIGRATE_IMAGE=ghcr.io/hideinmatrix/micromatrix-crm-migrate:v0.0.2
WEB_IMAGE=ghcr.io/hideinmatrix/micromatrix-crm-web:v0.0.2

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=default

# API 与 migrate 容器运行在同一个 Docker Compose 网络内，
# 因此数据库主机名使用 service name：postgres，而不是 localhost。
DATABASE_URL=postgresql://postgres:change_me_postgres_password@postgres:5432/default?schema=public

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# 生产环境必须替换为高强度随机值。
JWT_ACCESS_SECRET=change_me_with_a_strong_random_access_secret
JWT_REFRESH_SECRET=change_me_with_a_strong_random_refresh_secret

# 可选，docker-compose.release.yml 中已有默认值。
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 企业集成凭据加密密钥，生产环境必须使用至少 32 位随机值。
INTEGRATION_CREDENTIALS_KEY=change_me_with_at_least_32_random_characters

# 企业微信默认租户。
WECOM_DEFAULT_TENANT_SLUG=demo

# 对外可访问的 Web 地址；企微 OAuth 回跳等场景会使用。
# 正式部署时改为实际域名，例如 https://crm.example.com。
WEB_PUBLIC_URL=http://localhost:8080

# 是否启用 Swagger。
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------

# Web 对宿主机暴露的端口。
WEB_PORT=8080
