{
  "name": "@micromatrix/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node ../../tools/api-dev.mjs",
    "build": "prisma contract emit && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "prisma contract emit && tsc --noEmit",
    "test:pool-recycle": "tsx tests/pool-recycle-evaluator.test.ts",
    "test:external-event-notifications": "tsx tests/external-event-notifications.test.ts",
    "test:notification-batch-detail": "tsx tests/notification-batch-detail.test.ts",
    "test:notification-aggregation-runtime": "tsx tests/notification-aggregation-runtime.test.ts",
    "test:notification-aggregation-store": "tsx tests/notification-aggregation-store.test.ts",
    "test:message-aggregation": "tsx tests/message-aggregation.test.ts",
    "test:wecom-message-token": "tsx tests/wecom-message-token.test.ts",
    "test:delivery-executor": "tsx tests/delivery-executor.test.ts",
    "test:external-event-performance": "tsx tests/external-event-performance.test.ts",
    "test:form-config-read-memo": "tsx tests/form-config-read-memo.test.ts",
    "test:notification-preparation-reads": "tsx tests/notification-preparation-reads.test.ts",
    "test:external-event-outbox": "tsx tests/external-event-notification-outbox.test.ts",
    "test:lead-conversion-concurrency": "tsx tests/lead-conversion-concurrency.test.ts",
    "test:transactional-capacity": "tsx tests/transactional-capacity.test.ts",
    "test:business-write-fast-path": "tsx tests/business-write-fast-path.test.ts",
    "test:business-preparation-fast-path": "tsx tests/business-preparation-fast-path.test.ts",
    "prisma:generate": "prisma contract emit",
    "prisma:migrate": "prisma contract emit && prisma migration plan",
    "prisma:deploy": "prisma db migrate --advance-ref db --yes",
    "prisma:status": "prisma migration status",
    "prisma:verify": "prisma db verify",
    "prisma:migration-check": "prisma migration check",
    "prisma:infer": "prisma contract infer --output src/prisma/contract.prisma",
    "prisma:emit": "prisma contract emit",
    "db:seed": "tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@micromatrix/shared": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/orm-postgres": "8.0.0-rc.10",
    "@js-temporal/polyfill": "^0.5.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "prisma": "8.0.0-rc.14",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  }
}
