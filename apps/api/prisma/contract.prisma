    @@index([tenantId, enabled, deletedAt], map: "approval_flows_tenantId_enabled_deletedAt_idx")
    @@index([tenantId, formType, deletedAt], map: "approval_flows_tenantId_formType_deletedAt_idx")
    @@index([tenantId, number], map: "approval_flows_tenantId_number_key", unique: true)
    @@map("approval_flows")
  }

