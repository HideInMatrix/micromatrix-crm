// 多租户约定：除 Plan 外所有业务表都带 tenantId，查询必须显式过滤。
// 内部使用阶段只有一个租户；未来商业化开放注册即可，无需迁移数据。
// 后续可升级为 PostgreSQL RLS（行级安全）做数据库层强制隔离。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // API 是 CommonJS 工程，生成的客户端需保持一致，否则运行时会被 Node 误判为 ESM
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EnterpriseIntegrationProvider {
  WECOM
  DINGTALK
  LARK
}

enum ExternalIdentityStatus {
  ACTIVE
  REVOKED
}

enum ExternalOAuthFlow {
  QR_WECOM
  WECOM
}

enum MessageDeliveryChannel {
  WECOM
  DINGTALK
  LARK
  EMAIL
}

enum MessageDeliveryStatus {
  PENDING
  SENDING
  SUCCEEDED
  FAILED
  DEAD
}

enum OrganizationSyncStatus {
  FETCHING
  PREVIEW_READY
  APPLYING
  SUCCEEDED
  FAILED
  INVALIDATED
}

enum OrganizationSyncResourceType {
  DEPARTMENT
  USER
}

enum OrganizationSyncAction {
  CREATE
  UPDATE
  DISABLE
  UNCHANGED
  CONFLICT
  SKIP
}

enum OrganizationSyncItemResult {
  PENDING
  RESOLVED
  APPLIED
  SKIPPED
  FAILED
}

enum OrganizationSyncResolution {
  BIND
  SKIP
}

// 数据范围（角色的数据可见边界）
enum DataScope {
  ALL // 全部数据
  DEPT_AND_CHILD // 本部门及下级部门
  DEPT // 本部门
  SELF // 仅本人
  CUSTOM // 自定义部门
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                      User[]
  roles                      Role[]
  userRoles                  UserRole[]
  customers                  Customer[]
  contacts                   Contact[]
  subscriptions              Subscription[]
  departments                Department[]
  moduleConfigs              ModuleConfig[]
  topNavigationConfigs       TopNavigationConfig[]
  messageTaskSettings        MessageTaskSetting[]
  enterpriseIntegrations     EnterpriseIntegration[]
  externalDepartmentMappings ExternalDepartmentMapping[]
  externalUserMappings       ExternalUserMapping[]
  externalIdentities         ExternalIdentity[]
  externalOAuthStates        ExternalOAuthState[]
  messageDeliveries          MessageDelivery[]
  organizationSyncBatches    OrganizationSyncBatch[]

  @@map("tenants")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  leaderId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                      @relation(fields: [tenantId], references: [id])
  parent           Department?                 @relation("DeptTree", fields: [parentId], references: [id])
  children         Department[]                @relation("DeptTree")
  users            User[]
  externalMappings ExternalDepartmentMapping[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("departments")
}

model User {
  id                   String     @id @default(cuid())
  tenantId             String
  email                String?
  passwordHash         String
  name                 String
  status               UserStatus @default(ACTIVE)
  deptId               String?
  // 直属上级（逐级审批的汇报线）
  leaderId             String?
  position             String?
  phone                String?
  // Cordys sys_user.gender：false=男，true=女。
  gender               Boolean    @default(false)
  // 企业微信等外部来源成员在建立统一登录前禁止使用普通密码登录
  passwordLoginEnabled Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  dept               Department?           @relation(fields: [deptId], references: [id])
  userRoles          UserRole[]
  ownedCustomers     Customer[]
  ownedContacts      Contact[]
  externalMappings   ExternalUserMapping[]
  externalIdentities ExternalIdentity[]
  messageDeliveries  MessageDelivery[]
  extension          UserExtension?

  @@index([tenantId])
  @@index([tenantId, deptId])
  @@index([email])
  @@map("users")
}

// 对齐 Cordys sys_user_extend：头像和第三方平台扩展数据不进入用户主表。
model UserExtension {
  id           String @id
  avatar       String?
  platformInfo Bytes?

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("user_extensions")
}

model Role {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  // 权限码列表（menu:* 为菜单权限，资源:操作 为动作权限），'*' 表示全部权限
  permissions  String[]  @default([])
  // 数据范围与自定义部门（dataScope=CUSTOM 时生效）
  dataScope    DataScope @default(SELF)
  scopeDeptIds String[]  @default([])
  // 系统内置角色（管理员）不可删除/降权
  isSystem     Boolean   @default(false)
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                           Tenant                  @relation(fields: [tenantId], references: [id])
  userRoles                        UserRole[]
  defaultForEnterpriseIntegrations EnterpriseIntegration[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId, roleId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  industry       String?
  phone          String?
  email          String?
  remark         String?
  // 自定义字段值（cf_* 键），由元数据引擎驱动
  customData     Json?
  ownerId        String?
  // 归属部门（负责人变更时同步），数据范围过滤依据
  deptId         String?
  // 公海：无负责人，可被领取
  inSea          Boolean   @default(false)
  // 当前所在公海池；兼容旧数据时可为空
  poolId         String?
  // 当前负责人开始持有该客户的时间，用于领取冷却/负责人历史
  collectedAt    DateTime?
  poolEnteredAt  DateTime?
  lastFollowedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  owner         User?                @relation(fields: [ownerId], references: [id])
  contacts      Contact[]
  teamMembers   CustomerTeamMember[]
  opportunities Opportunity[]
  quotes        Quote[]
  contracts     Contract[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, deptId])
  @@index([tenantId, inSea])
  @@index([tenantId, poolId])
  @@map("customers")
}

model CustomerTeamMember {
  id                String   @id @default(cuid())
  tenantId          String
  customerId        String
  userId            String
  // 兼容旧前端展示；新逻辑统一使用 collaborationType
  role              String?
  // READ_ONLY / COLLABORATION
  collaborationType String   @default("COLLABORATION")
  createdById       String?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId])
  @@index([tenantId, userId])
  @@map("customer_team_members")
}

model CustomerRelation {
  id               String   @id @default(cuid())
  tenantId         String
  // 集团客户
  sourceCustomerId String
  // 子公司客户
  targetCustomerId String
  createdAt        DateTime @default(now())

  @@unique([tenantId, sourceCustomerId, targetCustomerId])
  @@index([tenantId, sourceCustomerId])
  @@index([tenantId, targetCustomerId])
  @@map("customer_relations")
}

// ============ 线索 ============

enum LeadStatus {
  FOLLOWING // 跟进中
  CONVERTED // 已转化
  INVALID // 无效
}

model Lead {
  id             String     @id @default(cuid())
  tenantId       String
  name           String
  contactName    String?
  phone          String?
  email          String?
  status         LeadStatus @default(FOLLOWING)
  // 线索池：无负责人，可被领取
  inPool         Boolean    @default(false)
  // 当前所在的线索池；兼容旧数据时可为空
  poolId         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  // Cordys 转换关系：当前使用 CUSTOMER，字符串结构便于后续扩展其它目标类型。
  transitionType String?
  transitionId   String?
  // 当前负责人开始持有该线索的时间，用于领取冷却/负责人历史
  collectedAt    DateTime?
  poolEnteredAt  DateTime?
  lastFollowedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId, inPool])
  @@index([tenantId, poolId])
  @@index([tenantId, deptId])
  @@index([tenantId, status])
  @@index([tenantId, transitionType, transitionId])
  @@map("leads")
}

// ============ 跟进记录（多态：线索/客户/商机/合同） ============

model FollowUpRecord {
  id           String    @id @default(cuid())
  tenantId     String
  targetType   String
  targetId     String
  type         String
  content      String
  nextFollowAt DateTime?
  ownerId      String
  ownerName    String
  createdAt    DateTime  @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("follow_up_records")
}

enum FollowUpPlanStatus {
  PREPARED
  UNDERWAY
  COMPLETED
  CANCELLED
}

// ============ 跟进计划（多态：线索/客户/商机） ============

model FollowUpPlan {
  id                String             @id @default(cuid())
  tenantId          String
  targetType        String
  targetId          String
  contactId         String?
  content           String
  method            String?
  estimatedAt       DateTime?
  status            FollowUpPlanStatus @default(PREPARED)
  converted         Boolean            @default(false)
  convertedRecordId String?
  ownerId           String
  deptId            String?
  createdById       String
  dueNotifiedAt     DateTime?
  customData        Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId, targetType, targetId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, estimatedAt, status])
  @@map("follow_up_plans")
}

// ============ 商机（可配置阶段） ============

model OpportunityStage {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  // 赢率（0-100），用于漏斗与预测
  probability Int     @default(0)
  sort        Int     @default(0)
  // 结果阶段：赢单/输单（系统内置，不可删除）
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)
  system      Boolean @default(false)

  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("opportunity_stages")
}

model Opportunity {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  customerId      String
  contactId       String?
  stageId         String
  amount          Decimal?  @db.Decimal(14, 2)
  expectedCloseAt DateTime?
  lostReason      String?
  remark          String?
  ownerId         String?
  deptId          String?
  customData      Json?
  wonAt           DateTime?
  lostAt          DateTime?
  lastFollowedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer  Customer              @relation(fields: [customerId], references: [id])
  contact   Contact?              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  stage     OpportunityStage      @relation(fields: [stageId], references: [id])
  stageLogs OpportunityStageLog[]
  items     OpportunityItem[]

  @@index([tenantId, stageId])
  @@index([tenantId, deptId])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@map("opportunities")
}

model OpportunityStageLog {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  fromStageName String?
  toStageName   String
  userName      String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_stage_logs")
}

model OpportunityItem {
  id            String  @id @default(cuid())
  opportunityId String
  productId     String?
  productName   String
  unit          String?
  quantity      Decimal @default(1) @db.Decimal(14, 2)
  unitPrice     Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(100) @db.Decimal(5, 2)
  amount        Decimal @default(0) @db.Decimal(14, 2)
  sort          Int     @default(0)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_items")
}

// ============ 产品 ============

enum ProductStatus {
  ON // 上架
  OFF // 下架
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  category    String?
  unit        String?
  price       Decimal       @default(0) @db.Decimal(14, 2)
  cost        Decimal?      @db.Decimal(14, 2)
  status      ProductStatus @default(ON)
  description String?
  customData  Json?
  ownerId     String?
  deptId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, status])
  @@map("products")
}

// ============ 报价 ============

enum QuoteStatus {
  DRAFT // 草稿
  CONFIRMED // 已确认
  VOID // 已作废
}

model Quote {
  id             String      @id @default(cuid())
  tenantId       String
  code           String
  name           String
  customerId     String
  opportunityId  String?
  totalAmount    Decimal     @default(0) @db.Decimal(14, 2)
  status         QuoteStatus @default(DRAFT)
  // 审批状态：NONE=无需/未提交, PENDING/APPROVED/REJECTED
  approvalStatus String      @default("NONE")
  validUntil     DateTime?
  remark         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id])
  items    QuoteItem[]

  @@unique([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, deptId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  productName String
  unit        String?
  quantity    Decimal @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  // 折扣百分比（100 = 不打折）
  discount    Decimal @default(100) @db.Decimal(5, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  sort        Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

// ============ 合同与回款 ============

enum ContractStatus {
  DRAFT // 草稿
  EXECUTING // 履约中
  COMPLETED // 已完成
  TERMINATED // 已终止
}

model Contract {
  id             String         @id @default(cuid())
  tenantId       String
  code           String
  name           String
  customerId     String
  opportunityId  String?
  quoteId        String?
  amount         Decimal        @default(0) @db.Decimal(14, 2)
  status         ContractStatus @default(DRAFT)
  approvalStatus String         @default("NONE")
  signedAt       DateTime?
  startAt        DateTime?
  endAt          DateTime?
  remark         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  items             ContractItem[]
  receivablePlans   ReceivablePlan[]
  receivableRecords ReceivableRecord[]
  invoices          InvoiceRecord[]
  orders            Order[]

  @@unique([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, deptId])
  @@map("contracts")
}

model ContractItem {
  id          String  @id @default(cuid())
  contractId  String
  productId   String?
  productName String
  unit        String?
  quantity    Decimal @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(100) @db.Decimal(5, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  sort        Int     @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_items")
}

model ReceivablePlan {
  id         String   @id @default(cuid())
  tenantId   String
  contractId String
  period     Int
  amount     Decimal  @default(0) @db.Decimal(14, 2)
  dueDate    DateTime
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contract Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  records  ReceivableRecord[]

  @@index([tenantId, contractId])
  @@index([tenantId, dueDate])
  @@map("receivable_plans")
}

model ReceivableRecord {
  id             String   @id @default(cuid())
  tenantId       String
  contractId     String
  planId         String?
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  receivedAt     DateTime
  method         String?
  remark         String?
  approvalStatus String   @default("NONE")
  ownerId        String?
  deptId         String?
  createdAt      DateTime @default(now())

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  plan     ReceivablePlan? @relation(fields: [planId], references: [id])

  @@index([tenantId, contractId])
  @@map("receivable_records")
}

// ============ 工商抬头与发票 ============

model InvoiceTitle {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  name        String
  taxNo       String
  bankName    String?
  bankAccount String?
  address     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices InvoiceRecord[]

  @@index([tenantId, customerId])
  @@map("invoice_titles")
}

enum InvoiceStatus {
  PENDING // 待开票
  ISSUED // 已开票
  VOID // 已作废
}

model InvoiceRecord {
  id         String        @id @default(cuid())
  tenantId   String
  contractId String
  titleId    String?
  amount     Decimal       @default(0) @db.Decimal(14, 2)
  type       String        @default("增值税普通发票")
  status     InvoiceStatus @default(PENDING)
  invoiceNo  String?
  issuedAt   DateTime?
  remark     String?
  ownerId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  contract Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title    InvoiceTitle? @relation(fields: [titleId], references: [id])

  @@index([tenantId, contractId])
  @@map("invoice_records")
}

// ============ 订单（合同履约执行） ============

enum OrderStatus {
  PENDING // 待交付
  DELIVERING // 交付中
  ACCEPTED // 已验收
  COMPLETED // 已完成
  CANCELED // 已取消
}

model Order {
  id             String      @id @default(cuid())
  tenantId       String
  code           String
  name           String
  contractId     String
  amount         Decimal     @default(0) @db.Decimal(14, 2)
  status         OrderStatus @default(PENDING)
  approvalStatus String      @default("NONE")
  deliveredAt    DateTime?
  acceptedAt     DateTime?
  remark         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, contractId])
  @@index([tenantId, deptId])
  @@map("orders")
}

// ============ 审批流引擎 ============

// 审批人策略
enum ApproverType {
  USER // 指定成员
  ROLE // 指定角色（该角色全部成员）
  DEPT_LEADER // 发起人部门主管
  DIRECT_LEADER // 发起人直属上级
}

// 多审批人模式
enum ApprovalMode {
  ALL // 会签（全部通过）
  ANY // 或签（任一通过）
}

enum ApprovalFormType {
  QUOTATION
  CONTRACT
  INVOICE
  ORDER
  // 仅用于保留 W2.5 前历史回款审批配置，不对配置 API 暴露。
  RECEIVABLE_RECORD_LEGACY
}

enum ApprovalExecuteTiming {
  CREATE
  UPDATE
  DELETE
}

enum ApprovalNodeType {
  START
  APPROVER
  CONDITION
  DEFAULT
  END
}

enum DuplicateApproverRule {
  FIRST_ONLY
  SEQUENTIAL_ALL
  EACH
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalFlow {
  id                    String                @id @default(cuid())
  tenantId              String
  number                String
  formType              ApprovalFormType
  currentVersionId      String?
  name                  String
  createExecute         Boolean               @default(true)
  updateExecute         Boolean               @default(false)
  deleteExecute         Boolean               @default(false)
  submitterCanRevoke    Boolean               @default(true)
  allowBatchProcess     Boolean               @default(false)
  allowWithdraw         Boolean               @default(false)
  allowAddSign          Boolean               @default(false)
  duplicateApproverRule DuplicateApproverRule @default(FIRST_ONLY)
  requireComment        Boolean               @default(false)
  enabled               Boolean               @default(false)
  description           String?               @db.VarChar(1000)
  // 触发条件：{ amountGte?: number }，不满足条件则无需审批
  condition             Json?
  deletedAt             DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  currentVersion ApprovalFlowVersion?  @relation("CurrentFlowVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ApprovalFlowVersion[] @relation("FlowVersions")
  instances      ApprovalInstance[]

  @@unique([tenantId, number])
  @@index([tenantId, formType, deletedAt])
  @@index([tenantId, enabled, deletedAt])
  @@map("approval_flows")
}

model ApprovalFlowNumberCounter {
  id        String           @id @default(cuid())
  tenantId  String
  formType  ApprovalFormType
  nextValue Int              @default(1)
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, formType])
  @@map("approval_flow_number_counters")
}

model ApprovalFlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  tenantId    String
  version     Int
  createdById String?
  createdAt   DateTime @default(now())

  flow            ApprovalFlow       @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Restrict)
  currentForFlows ApprovalFlow[]     @relation("CurrentFlowVersion")
  nodes           ApprovalNode[]
  links           ApprovalNodeLink[]
  instances       ApprovalInstance[]

  @@unique([flowId, version])
  @@index([tenantId, flowId])
  @@map("approval_flow_versions")
}

model ApprovalNode {
  id            String                @id @default(cuid())
  flowVersionId String
  number        String
  name          String
  nodeType      ApprovalNodeType
  executeTiming ApprovalExecuteTiming @default(CREATE)
  sort          Int                   @default(0)

  flowVersion   ApprovalFlowVersion   @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  approver      ApprovalNodeApprover?
  outgoingLinks ApprovalNodeLink[]    @relation("ApprovalNodeOutgoing")
  incomingLinks ApprovalNodeLink[]    @relation("ApprovalNodeIncoming")

  @@unique([flowVersionId, number])
  @@index([flowVersionId, executeTiming, sort])
  @@map("approval_nodes")
}

model ApprovalNodeApprover {
  id           String       @id @default(cuid())
  nodeId       String       @unique
  approverType ApproverType
  // USER=用户ID集合；ROLE=角色ID集合
  approverIds  String[]     @default([])
  mode         ApprovalMode @default(ANY)

  node ApprovalNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@map("approval_node_approvers")
}

model ApprovalNodeLink {
  id            String @id @default(cuid())
  flowVersionId String
  fromNodeId    String
  toNodeId      String
  sort          Int    @default(0)

  flowVersion ApprovalFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  fromNode    ApprovalNode        @relation("ApprovalNodeOutgoing", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode      ApprovalNode        @relation("ApprovalNodeIncoming", fields: [toNodeId], references: [id], onDelete: Restrict)

  @@unique([flowVersionId, fromNodeId, toNodeId])
  @@index([flowVersionId, sort])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("approval_node_links")
}

model ApprovalInstance {
  id               String                 @id @default(cuid())
  tenantId         String
  flowId           String?
  flowVersionId    String?
  executeTiming    ApprovalExecuteTiming  @default(CREATE)
  module           String
  targetId         String
  targetName       String
  // 摘要（金额等，用于列表展示）
  summary          String?
  status           ApprovalInstanceStatus @default(PENDING)
  currentNodeIndex Int                    @default(0)
  // 节点快照（提交时冻结流程配置）：[{ name, approverType, mode, approverIds }]
  nodesSnapshot    Json
  submitterId      String
  submitterName    String
  finishedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  flow        ApprovalFlow?        @relation(fields: [flowId], references: [id], onDelete: SetNull)
  flowVersion ApprovalFlowVersion? @relation(fields: [flowVersionId], references: [id], onDelete: SetNull)
  tasks       ApprovalTask[]

  @@index([tenantId, status])
  @@index([tenantId, module, targetId])
  @@index([tenantId, submitterId])
  @@index([flowId, status])
  @@index([flowVersionId])
  @@map("approval_instances")
}

model ApprovalTask {
  id         String             @id @default(cuid())
  tenantId   String
  instanceId String
  nodeIndex  Int
  nodeName   String
  approverId String
  status     ApprovalTaskStatus @default(PENDING)
  comment    String?
  handledAt  DateTime?
  createdAt  DateTime           @default(now())

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, approverId, status])
  @@index([instanceId])
  @@map("approval_tasks")
}

// ============ 标讯（招投标信息） ============

model BiddingSource {
  id          String    @id @default(cuid())
  tenantId    String
  // 适配器标识：demo / jianyu / qianlima ...
  provider    String
  name        String
  // 数据源凭证（API Key 等）
  credentials Json?
  enabled     Boolean   @default(false)
  lastFetchAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, provider])
  @@map("bidding_sources")
}

model BiddingKeywordSub {
  id        String   @id @default(cuid())
  tenantId  String
  keyword   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, keyword])
  @@map("bidding_keyword_subs")
}

model BiddingInfo {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  // 公告类型：招标公告/中标公告/更正公告等
  type            String?
  region          String?
  buyer           String?
  budget          Decimal?  @db.Decimal(16, 2)
  publishedAt     DateTime?
  deadline        DateTime?
  sourceUrl       String?
  content         String?
  // 来源：demo/manual/...
  source          String?
  keyword         String?
  // 去重指纹（标题+发布日期）
  hash            String
  convertedLeadId String?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, hash])
  @@index([tenantId, publishedAt])
  @@map("bidding_infos")
}

// ============ 公海/线索池（Cordys 语义迁移后的通用抽象） ============

model ResourcePool {
  id             String   @id @default(cuid())
  tenantId       String
  // lead / customer
  module         String
  name           String
  // 可使用此池的成员/部门范围 ID。当前先存 scope token，后续统一 ScopeResolver 解析。
  scopeIds       String[] @default([])
  // 池管理员范围 ID
  managerIds     String[] @default([])
  enabled        Boolean  @default(true)
  autoRecycle    Boolean  @default(false)
  // 池列表中隐藏的元数据字段 ID
  hiddenFieldIds String[] @default([])
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pickRule    ResourcePoolPickRule?
  recycleRule ResourcePoolRecycleRule?

  @@unique([tenantId, module, name])
  @@index([tenantId, module, enabled])
  @@map("resource_pools")
}

model ResourcePoolPickRule {
  id                        String   @id @default(cuid())
  tenantId                  String
  poolId                    String   @unique
  limitDailyPick            Boolean  @default(false)
  dailyPickLimit            Int?
  limitPreviousOwner        Boolean  @default(false)
  previousOwnerCooldownDays Int?
  limitNewData              Boolean  @default(false)
  newDataCooldownDays       Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  pool ResourcePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("resource_pool_pick_rules")
}

model ResourcePoolRecycleRule {
  id         String   @id @default(cuid())
  tenantId   String
  poolId     String   @unique
  // AND / OR
  operator   String   @default("AND")
  // 通用规则条件数组，后续由 RuleConditionEvaluator 解释
  conditions Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pool ResourcePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("resource_pool_recycle_rules")
}

model ResourceCapacity {
  id          String   @id @default(cuid())
  tenantId    String
  // lead / customer
  module      String
  // 一个 scope token 只能属于一条同模块库容规则，由服务层保证不重叠
  scopeIds    String[] @default([])
  capacity    Int
  // Cordys 客户库容支持额外过滤条件；线索可为空
  filters     Json?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, module])
  @@map("resource_capacities")
}

model ResourceOwnerHistory {
  id          String    @id @default(cuid())
  tenantId    String
  // lead / customer
  module      String
  resourceId  String
  ownerId     String
  operatorId  String?
  poolId      String?
  reasonId    String?
  collectedAt DateTime?
  endedAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([tenantId, module, resourceId, endedAt])
  @@index([tenantId, ownerId, endedAt])
  @@map("resource_owner_histories")
}

// ============ 公海/线索池回收规则 ============

model PoolRule {
  id          String  @id @default(cuid())
  tenantId    String
  // lead / customer
  module      String
  enabled     Boolean @default(false)
  // 超过 N 天未跟进自动回收
  recycleDays Int     @default(30)
  // 回收前 N 天提醒负责人
  notifyDays  Int     @default(3)

  @@unique([tenantId, module])
  @@map("pool_rules")
}

model Contact {
  id            String   @id @default(cuid())
  tenantId      String
  customerId    String
  // Cordys 联系人具有独立负责人；协作用户只能看到/维护自己负责的联系人。
  ownerId       String?
  deptId        String?
  name          String
  phone         String?
  enable        Boolean  @default(true)
  disableReason String?
  customData    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, ownerId])
  @@index([tenantId, deptId])
  @@index([tenantId, enable])
  @@map("contacts")
}

// ============ 订阅/套餐（商业化预留，内部阶段不启用计费逻辑） ============

model Plan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  maxUsers  Int      @default(10)
  features  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ============ 元数据引擎：字段定义（驱动动态表单/列表/筛选） ============

model FieldDefinition {
  id         String   @id @default(cuid())
  tenantId   String
  // 业务对象：lead / customer / contact / opportunity / product / quote / contract / order
  module     String
  // 字段键：系统字段=实体列名；自定义字段=cf_ 前缀，值存业务表的 customData JSONB
  key        String
  label      String
  // text/textarea/number/currency/percent/date/datetime/select/multiselect/radio
  // /checkbox/switch/member/dept/phone/email/formula
  type       String
  required   Boolean  @default(false)
  // 系统字段：不可删除、key/type 不可修改
  system     Boolean  @default(false)
  hidden     Boolean  @default(false)
  // 选项集（select/multiselect/radio/checkbox）：[{ label, value, color? }]
  options    Json?
  // 扩展配置：placeholder/默认值/公式表达式/小数位等
  config     Json?
  // 表单布局：排序与栅格宽度（24 栅格制）
  sort       Int      @default(0)
  span       Int      @default(12)
  // 列表配置
  showInList Boolean  @default(true)
  listWidth  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, module, key])
  @@index([tenantId, module])
  @@map("field_definitions")
}

// ============ 保存的用户视图（Cordys UserView 语义迁移） ============

model SavedView {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  // lead / lead_pool / customer / customer_pool / opportunity / contract ...
  module     String
  name       String
  fixed      Boolean  @default(false)
  enabled    Boolean  @default(true)
  sort       Int      @default(0)
  // AND / OR
  searchMode String   @default("AND")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conditions SavedViewCondition[]

  @@unique([tenantId, userId, module, name])
  @@index([tenantId, userId, module, enabled, sort])
  @@map("saved_views")
}

model SavedViewCondition {
  id              String   @id @default(cuid())
  tenantId        String
  viewId          String
  field           String
  operator        String
  // Prisma JSON 可直接保留 string/number/boolean/array/object/null，
  // 不需要复刻 Java 的 value + valueType 字符串序列化方案。
  value           Json?
  fieldType       String?
  multipleValue   Boolean  @default(false)
  containChildIds String[] @default([])
  sort            Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  view SavedView @relation(fields: [viewId], references: [id], onDelete: Cascade)

  @@index([tenantId, viewId, sort])
  @@map("saved_view_conditions")
}

// ============ 系统：日志 / 通知 / 设置 / 附件 ============

model OperationLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userName   String?
  module     String
  action     String
  targetId   String?
  targetName String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@map("operation_logs")
}

model LoginLog {
  id                 String   @id @default(cuid())
  tenantId           String?
  userId             String?
  email              String
  authType           String   @default("PASSWORD")
  externalSubject    String?
  externalIdentityId String?
  ip                 String?
  userAgent          String?
  success            Boolean
  message            String?
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, authType, createdAt])
  @@map("login_logs")
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  // 业务类型：assign / approval / receivable / pool / follow_plan / system
  type      String
  title     String
  content   String?
  // 前端跳转路由
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model MessageTaskSetting {
  id            String   @id @default(cuid())
  tenantId      String
  module        String
  event         String
  systemEnabled Boolean  @default(true)
  emailEnabled  Boolean  @default(false)
  weComEnabled  Boolean  @default(false)
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, event])
  @@index([tenantId, module])
  @@map("message_task_settings")
}

model SystemSetting {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    Json

  @@unique([tenantId, key])
  @@map("system_settings")
}

model EnterpriseIntegration {
  id                String                        @id @default(cuid())
  tenantId          String
  provider          EnterpriseIntegrationProvider
  corpId            String
  agentId           String
  secretCiphertext  String
  secretIv          String
  secretAuthTag     String
  secretKeyVersion  Int                           @default(1)
  credentialVersion Int                           @default(1)
  syncEnabled       Boolean                       @default(false)
  syncDefaultRoleId String?
  lastTestSucceeded Boolean?
  lastTestMessage   String?
  lastTestedAt      DateTime?
  lastSyncStatus    OrganizationSyncStatus?
  lastSyncMessage   String?
  lastSyncedAt      DateTime?
  createdById       String
  updatedById       String
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncDefaultRole    Role?                   @relation(fields: [syncDefaultRoleId], references: [id], onDelete: SetNull)
  syncBatches        OrganizationSyncBatch[]
  externalIdentities ExternalIdentity[]
  oauthStates        ExternalOAuthState[]
  messageDeliveries  MessageDelivery[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([syncDefaultRoleId])
  @@map("enterprise_integrations")
}

model ExternalDepartmentMapping {
  id              String                        @id @default(cuid())
  tenantId        String
  provider        EnterpriseIntegrationProvider
  externalId      String
  externalKey     String
  departmentId    String
  active          Boolean                       @default(true)
  lastSeenBatchId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lastSeenBatch OrganizationSyncBatch? @relation("DepartmentMappingLastSeen", fields: [lastSeenBatchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, externalKey])
  @@unique([tenantId, provider, departmentId])
  @@index([tenantId, provider, active])
  @@index([lastSeenBatchId])
  @@map("external_department_mappings")
}

model ExternalUserMapping {
  id              String                        @id @default(cuid())
  tenantId        String
  provider        EnterpriseIntegrationProvider
  externalId      String
  externalKey     String
  userId          String
  active          Boolean                       @default(true)
  lastSeenBatchId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenBatch    OrganizationSyncBatch? @relation("UserMappingLastSeen", fields: [lastSeenBatchId], references: [id], onDelete: SetNull)
  externalIdentity ExternalIdentity?

  @@unique([tenantId, provider, externalKey])
  @@unique([tenantId, provider, userId])
  @@index([tenantId, provider, active])
  @@index([lastSeenBatchId])
  @@map("external_user_mappings")
}

model ExternalIdentity {
  id              String                        @id @default(cuid())
  tenantId        String
  integrationId   String
  mappingId       String                        @unique
  provider        EnterpriseIntegrationProvider
  externalSubject String
  userId          String
  status          ExternalIdentityStatus        @default(ACTIVE)
  bindingSource   String                        @default("LOGIN")
  boundById       String?
  boundAt         DateTime                      @default(now())
  revokedById     String?
  revokedAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration EnterpriseIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  mapping     ExternalUserMapping   @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalSubject])
  @@unique([tenantId, provider, userId])
  @@index([tenantId, provider, status])
  @@index([integrationId])
  @@map("external_identities")
}

model ExternalOAuthState {
  id               String            @id @default(cuid())
  tenantId         String
  integrationId    String
  flow             ExternalOAuthFlow
  stateHash        String            @unique
  browserNonceHash String
  returnPath       String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime          @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration EnterpriseIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([tenantId, flow, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("external_oauth_states")
}

model MessageDelivery {
  id                String                 @id @default(cuid())
  tenantId          String
  integrationId     String?
  channel           MessageDeliveryChannel
  event             String
  userId            String?
  externalSubject   String?
  title             String
  content           String?
  link              String?
  status            MessageDeliveryStatus  @default(PENDING)
  attempts          Int                    @default(0)
  maxAttempts       Int                    @default(3)
  nextAttemptAt     DateTime?
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration EnterpriseIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, event, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("message_deliveries")
}

model OrganizationSyncBatch {
  id                String                        @id @default(cuid())
  tenantId          String
  integrationId     String
  provider          EnterpriseIntegrationProvider
  status            OrganizationSyncStatus
  credentialVersion Int
  counts            Json
  errorCode         String?
  errorMessage      String?
  createdById       String
  appliedById       String?
  fetchStartedAt    DateTime?
  previewedAt       DateTime?
  applyStartedAt    DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  tenant                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration            EnterpriseIntegration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  items                  OrganizationSyncItem[]
  seenDepartmentMappings ExternalDepartmentMapping[] @relation("DepartmentMappingLastSeen")
  seenUserMappings       ExternalUserMapping[]       @relation("UserMappingLastSeen")

  @@index([tenantId, provider, createdAt])
  @@index([integrationId, status])
  @@map("organization_sync_batches")
}

model OrganizationSyncItem {
  id                String                       @id @default(cuid())
  tenantId          String
  batchId           String
  resourceType      OrganizationSyncResourceType
  externalId        String
  externalKey       String
  action            OrganizationSyncAction
  result            OrganizationSyncItemResult   @default(PENDING)
  localId           String?
  parentExternalKey String?
  sourceData        Json
  changes           Json?
  conflictType      String?
  conflictMessage   String?
  resolution        OrganizationSyncResolution?
  resolvedLocalId   String?
  errorMessage      String?
  sort              Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  batch OrganizationSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, resourceType, externalKey])
  @@index([tenantId, batchId, resourceType, action])
  @@map("organization_sync_items")
}

model ModuleConfig {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  enabled  Boolean @default(true)
  sort     Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, sort])
  @@map("module_configs")
}

model TopNavigationConfig {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  enabled  Boolean @default(true)
  sort     Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, sort])
  @@map("top_navigation_configs")
}

model Attachment {
  id         String   @id @default(cuid())
  tenantId   String
  uploaderId String?
  name       String
  path       String
  size       Int      @default(0)
  mime       String?
  // 挂载对象（跟进记录/合同等）
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("attachments")
}

// ============ 导出任务中心（R2：先同步生成文件，Wave 6 可替换为 BullMQ 执行器） ============

model ExportTask {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  module       String
  fileName     String
  filePath     String?
  status       String    @default("PENDING")
  rowCount     Int       @default(0)
  fileSize     Int?
  errorMessage String?
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([expiresAt])
  @@map("export_tasks")
}
