  @@unique([tenantId, displayName])
  @@index([tenantId, enable])
  @@map("enterprise_ai_models")
}

model EnterpriseAiModelRoute {
  id        String   @id @default(cuid())
  tenantId  String
  modelId   String
  sort      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modelId])
  @@unique([tenantId, sort])
  @@index([tenantId])
  @@map("enterprise_ai_model_routes")
}

model EnterpriseTermCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms  EnterpriseTerm[]

  @@unique([tenantId, name])
  @@index([tenantId, sort])
  @@map("enterprise_term_categories")
}

model EnterpriseTerm {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String
  standardTerm    String
  alsoCalled      String   @default("")
  avoidThese      String   @default("")
  useCase         String   @default("")
  systemReference String   @default("")
  enable          Boolean  @default(true)
  createdById     String
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category EnterpriseTermCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId, standardTerm])
  @@index([tenantId, enable])
  @@index([categoryId])
  @@map("enterprise_terms")
}

model EnterpriseTermDiscovery {
  id          String   @id @default(cuid())
  tenantId    String
  discovered  String
  source      String   @default("")
  context     String   @default("")
  status      String   @default("PENDING")
  adoptedTermId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("enterprise_term_discoveries")
}

model EnterpriseGlobalTask {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  triggerType       String   @default("manual")
  executionCondition String  @default("")
  executionAction   String   @default("")
  confirmationLevel String   @default("ask")
  applicableModelId String?
  enable            Boolean  @default(true)
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicableModel EnterpriseAiModel?              @relation(fields: [applicableModelId], references: [id], onDelete: SetNull)
  executions      EnterpriseGlobalTaskExecution[]

  @@unique([tenantId, name])
  @@index([tenantId, enable])
  @@index([applicableModelId])
  @@map("enterprise_global_tasks")
}

model EnterpriseGlobalTaskExecution {
  id           String   @id @default(cuid())
  tenantId     String
  taskId       String
  status       String   @default("PENDING")
  input        Json?
  output       Json?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   EnterpriseGlobalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([taskId, createdAt])
  @@map("enterprise_global_task_executions")
}

model EnterpriseIntegration {
  id                String                        @id @default(cuid())
  tenantId          String
  provider          EnterpriseIntegrationProvider
  corpId            String
  agentId           String
  secretCiphertext  String
  secretIv          String
  secretAuthTag     String
  secretKeyVersion  Int                           @default(1)
  credentialVersion Int                           @default(1)
  syncEnabled       Boolean                       @default(false)
  syncDefaultRoleId String?
  lastTestSucceeded Boolean?
  lastTestMessage   String?
  lastTestedAt      DateTime?
  lastSyncStatus    OrganizationSyncStatus?
  lastSyncMessage   String?
  lastSyncedAt      DateTime?
  createdById       String
  updatedById       String
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncDefaultRole    Role?                   @relation(fields: [syncDefaultRoleId], references: [id], onDelete: SetNull)
  syncBatches        OrganizationSyncBatch[]
  externalIdentities ExternalIdentity[]
  oauthStates        ExternalOAuthState[]
  messageDeliveries  MessageDelivery[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([syncDefaultRoleId])
  @@map("enterprise_integrations")
}

model ExternalDepartmentMapping {
  id              String                        @id @default(cuid())
  tenantId        String
  provider        EnterpriseIntegrationProvider
  externalId      String
  externalKey     String
  departmentId    String
  active          Boolean                       @default(true)
  lastSeenBatchId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department    Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lastSeenBatch OrganizationSyncBatch? @relation("DepartmentMappingLastSeen", fields: [lastSeenBatchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, externalKey])
  @@unique([tenantId, provider, departmentId])
  @@index([tenantId, provider, active])
  @@index([lastSeenBatchId])
  @@map("external_department_mappings")
}

model ExternalUserMapping {
  id              String                        @id @default(cuid())
  tenantId        String
  provider        EnterpriseIntegrationProvider
  externalId      String
  externalKey     String
  userId          String
  active          Boolean                       @default(true)
  lastSeenBatchId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenBatch    OrganizationSyncBatch? @relation("UserMappingLastSeen", fields: [lastSeenBatchId], references: [id], onDelete: SetNull)
  externalIdentity ExternalIdentity?

  @@unique([tenantId, provider, externalKey])
  @@unique([tenantId, provider, userId])
  @@index([tenantId, provider, active])
  @@index([lastSeenBatchId])
  @@map("external_user_mappings")
}

model ExternalIdentity {
  id              String                        @id @default(cuid())
  tenantId        String
  integrationId   String
  mappingId       String                        @unique
  provider        EnterpriseIntegrationProvider
  externalSubject String
  userId          String
  status          ExternalIdentityStatus        @default(ACTIVE)
  bindingSource   String                        @default("LOGIN")
  boundById       String?
  boundAt         DateTime                      @default(now())
  revokedById     String?
  revokedAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration EnterpriseIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  mapping     ExternalUserMapping   @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalSubject])
  @@unique([tenantId, provider, userId])
  @@index([tenantId, provider, status])
  @@index([integrationId])
  @@map("external_identities")
}

model ExternalOAuthState {
  id               String            @id @default(cuid())
  tenantId         String
  integrationId    String
  flow             ExternalOAuthFlow
  stateHash        String            @unique
  browserNonceHash String
  returnPath       String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime          @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration EnterpriseIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([tenantId, flow, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("external_oauth_states")
}

model MessageDelivery {
  id                String                 @id @default(cuid())
  tenantId          String
  integrationId     String?
  channel           MessageDeliveryChannel
  event             String
  userId            String?
  externalSubject   String?
  title             String
  content           String?
  link              String?
  status            MessageDeliveryStatus  @default(PENDING)
  attempts          Int                    @default(0)
  maxAttempts       Int                    @default(3)
  nextAttemptAt     DateTime?
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration EnterpriseIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, event, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("message_deliveries")
}

model OrganizationSyncBatch {
  id                 String                        @id @default(cuid())
  tenantId           String
  integrationId      String
  provider           EnterpriseIntegrationProvider
  status             OrganizationSyncStatus
  targetDepartmentId String
  credentialVersion  Int
  counts             Json
  errorCode          String?
  errorMessage       String?
  createdById        String
  appliedById        String?
  fetchStartedAt     DateTime?
  previewedAt        DateTime?
  applyStartedAt     DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  tenant                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration            EnterpriseIntegration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  items                  OrganizationSyncItem[]
  seenDepartmentMappings ExternalDepartmentMapping[] @relation("DepartmentMappingLastSeen")
  seenUserMappings       ExternalUserMapping[]       @relation("UserMappingLastSeen")

  @@index([tenantId, provider, createdAt])
  @@index([tenantId, targetDepartmentId, createdAt])
  @@index([integrationId, status])
  @@map("organization_sync_batches")
}

model OrganizationSyncItem {
  id                String                       @id @default(cuid())
  tenantId          String
  batchId           String
  resourceType      OrganizationSyncResourceType
  externalId        String
  externalKey       String
  action            OrganizationSyncAction
  result            OrganizationSyncItemResult   @default(PENDING)
  localId           String?
  parentExternalKey String?
  sourceData        Json
  changes           Json?
  conflictType      String?
  conflictMessage   String?
  resolution        OrganizationSyncResolution?
  resolvedLocalId   String?
  errorMessage      String?
  sort              Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  batch OrganizationSyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, resourceType, externalKey])
  @@index([tenantId, batchId, resourceType, action])
  @@map("organization_sync_items")
}

model ModuleConfig {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  enabled  Boolean @default(true)
  sort     Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, sort])
  @@map("module_configs")
}

model TopNavigationConfig {
  id       String  @id @default(cuid())
  tenantId String
  key      String
  enabled  Boolean @default(true)
  sort     Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, sort])
  @@map("top_navigation_configs")
}

model Attachment {
  id         String   @id @default(cuid())
  tenantId   String
  uploaderId String?
  name       String
  path       String
  size       Int      @default(0)
  mime       String?
  // 挂载对象（跟进记录/合同等）
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("attachments")
}

