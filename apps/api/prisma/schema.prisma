// ============ 合同（Cordys 直接模型）与回款 ============

model Contract {
  id             String  @id @default(cuid()) @db.VarChar(32)
  name           String  @db.VarChar(255)
  customerId     String  @map("customer_id") @db.VarChar(32)
  owner          String  @db.VarChar(32)
  amount         Decimal @default(0) @db.Decimal(14, 2)
  number         String  @db.VarChar(50)
  approvalStatus String  @default("NONE") @map("approval_status") @db.VarChar(50)
  stage          String  @db.VarChar(32)
  startTime      BigInt? @map("start_time")
  endTime        BigInt? @map("end_time")
  voidReason     String? @map("void_reason") @db.VarChar(255)
  organizationId String  @map("organization_id") @db.VarChar(32)
  pos            BigInt?
  approved       Boolean @default(false)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)

  customer         Customer                @relation(fields: [customerId], references: [id])
  fieldValues      ContractField[]
  fieldBlobValues  ContractFieldBlob[]
  snapshots        ContractSnapshot[]
  paymentPlans     ContractPaymentPlan[]
  paymentRecords   ContractPaymentRecord[]
  contractInvoices ContractInvoice[]
  orders           Order[]

  @@index([name])
  @@index([customerId])
  @@index([owner])
  @@index([number])
  @@index([organizationId])
  @@index([approvalStatus])
  @@index([stage])
  @@index([createUser])
  @@map("contract")
}

