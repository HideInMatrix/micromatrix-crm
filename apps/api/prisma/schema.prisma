// ============ 跟进记录（多态：线索/客户/商机/合同） ============

model FollowUpRecord {
  id           String    @id @default(cuid())
  tenantId     String
  targetType   String
  targetId     String
  type         String
  content      String
  nextFollowAt DateTime?
  ownerId      String
  ownerName    String
  createdAt    DateTime  @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("follow_up_records")
}

enum FollowUpPlanStatus {
  PREPARED
  UNDERWAY
  COMPLETED
  CANCELLED
}

// ============ 跟进计划（多态：线索/客户/商机） ============

model FollowUpPlan {
  id                String             @id @default(cuid())
  tenantId          String
  targetType        String
  targetId          String
  contactId         String?
  content           String
  method            String?
  estimatedAt       DateTime?
  status            FollowUpPlanStatus @default(PREPARED)
  converted         Boolean            @default(false)
  convertedRecordId String?
  ownerId           String
  deptId            String?
  createdById       String
  dueNotifiedAt     DateTime?
  customData        Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  fields     FollowUpPlanField[]
  fieldBlobs FollowUpPlanFieldBlob[]

  @@index([tenantId, targetType, targetId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, estimatedAt, status])
  @@map("follow_up_plans")
}

model FollowUpPlanField {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id")
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.VarChar(255)

  resource FollowUpPlan @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId, fieldId, fieldValue])
  @@map("follow_up_plan_field")
}

model FollowUpPlanFieldBlob {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id")
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.Text

  resource FollowUpPlan @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId])
  @@map("follow_up_plan_field_blob")
}

// ============ Cordys 商机直接模型 ============

model OpportunityStageConfig {
  id             String  @id @default(cuid()) @db.VarChar(32)
  name           String  @db.VarChar(16)
  type           String  @db.VarChar(50)
  rate           String  @db.VarChar(10)
  afootRollBack  Boolean @default(false) @map("afoot_roll_back")
  endRollBack    Boolean @default(false) @map("end_roll_back")
  pos            BigInt
  organizationId String  @map("organization_id") @db.VarChar(32)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)

  opportunities Opportunity[]

  @@index([organizationId])
  @@index([organizationId, pos])
  @@map("opportunity_stage_config")
}

model Opportunity {
  id              String   @id @default(cuid()) @db.VarChar(32)
  customerId      String?  @map("customer_id") @db.VarChar(32)
  name            String   @db.VarChar(255)
  amount          Decimal? @db.Decimal(20, 10)
  possible        Decimal? @db.Decimal(20, 10)
  // Cordys ListTypeHandler 将产品 ID 数组序列化为 JSON 文本写入 varchar(1000)。
  products        String?  @db.VarChar(1000)
  organizationId  String   @map("organization_id") @db.VarChar(32)
  lastStage       String?  @map("last_stage") @db.VarChar(32)
  stage           String   @db.VarChar(32)
  contactId       String?  @map("contact_id") @db.VarChar(32)
  owner           String   @db.VarChar(32)
  updateUser      String   @map("update_user") @db.VarChar(32)
  createTime      BigInt   @map("create_time")
  updateTime      BigInt   @map("update_time")
  createUser      String   @map("create_user") @db.VarChar(32)
  follower        String?  @db.VarChar(32)
  followTime      BigInt?  @map("follow_time")
  expectedEndTime BigInt?  @map("expected_end_time")
  actualEndTime   BigInt?  @map("actual_end_time")
  failureReason   String?  @map("failure_reason") @db.VarChar(50)
  pos             BigInt?

  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact         CustomerContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stageConfig     OpportunityStageConfig @relation(fields: [stage], references: [id])
  fieldValues     OpportunityField[]
  fieldBlobValues OpportunityFieldBlob[]
  quotations      OpportunityQuotation[]

  @@index([customerId])
  @@index([organizationId])
  @@index([stage])
  @@index([owner])
  @@index([follower])
  @@index([followTime])
  @@map("opportunity")
}

model OpportunityField {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.VarChar(255)

  resource Opportunity @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId, fieldId, fieldValue])
  @@map("opportunity_field")
}

model OpportunityFieldBlob {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.Text

  resource Opportunity @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId])
  @@map("opportunity_field_blob")
}

model OpportunityRule {
  id             String  @id @default(cuid()) @db.VarChar(32)
  name           String  @db.VarChar(255)
  organizationId String  @map("organization_id") @db.VarChar(32)
  ownerId        String  @map("owner_id") @db.Text
  scopeId        String  @map("scope_id") @db.Text
  enable         Boolean @default(true)
  auto           Boolean @default(false)
