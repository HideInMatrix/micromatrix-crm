// ============ 商机（可配置阶段） ============

model OpportunityStage {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  // 赢率（0-100），用于漏斗与预测
  probability Int     @default(0)
  sort        Int     @default(0)
  // 结果阶段：赢单/输单（系统内置，不可删除）
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)
  system      Boolean @default(false)

  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("opportunity_stages")
}

model Opportunity {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  customerId      String
  contactId       String?
  stageId         String
  amount          Decimal?  @db.Decimal(14, 2)
  expectedCloseAt DateTime?
  lostReason      String?
  remark          String?
  ownerId         String?
  deptId          String?
  customData      Json?
  wonAt           DateTime?
  lostAt          DateTime?
  lastFollowedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer  Customer              @relation(fields: [customerId], references: [id])
  contact   CustomerContact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  stage     OpportunityStage      @relation(fields: [stageId], references: [id])
  stageLogs OpportunityStageLog[]
  items     OpportunityItem[]

  @@index([tenantId, stageId])
  @@index([tenantId, deptId])
  @@index([tenantId, customerId])
  @@index([tenantId, contactId])
  @@map("opportunities")
}

model OpportunityStageLog {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  fromStageName String?
  toStageName   String
  userName      String
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_stage_logs")
}

model OpportunityItem {
  id            String  @id @default(cuid())
  opportunityId String
  productId     String?
  productName   String
  unit          String?
  quantity      Decimal @default(1) @db.Decimal(14, 2)
  unitPrice     Decimal @default(0) @db.Decimal(14, 2)
  discount      Decimal @default(100) @db.Decimal(5, 2)
  amount        Decimal @default(0) @db.Decimal(14, 2)
  sort          Int     @default(0)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_items")
}

// ============ 产品 ============

enum ProductStatus {
  ON // 上架
  OFF // 下架
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  category    String?
  unit        String?
  price       Decimal       @default(0) @db.Decimal(14, 2)
  cost        Decimal?      @db.Decimal(14, 2)
  status      ProductStatus @default(ON)
  description String?
  customData  Json?
  ownerId     String?
  deptId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, status])
  @@map("products")
}

// ============ 报价 ============

enum QuoteStatus {
  DRAFT // 草稿
  CONFIRMED // 已确认
  VOID // 已作废
}

model Quote {
  id             String      @id @default(cuid())
  tenantId       String
  code           String
  name           String
  customerId     String
  opportunityId  String?
  totalAmount    Decimal     @default(0) @db.Decimal(14, 2)
  status         QuoteStatus @default(DRAFT)
  // 审批状态：NONE=无需/未提交, PENDING/APPROVED/REJECTED
  approvalStatus String      @default("NONE")
  validUntil     DateTime?
  remark         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer Customer    @relation(fields: [customerId], references: [id])
  items    QuoteItem[]

  @@unique([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, deptId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  productName String
  unit        String?
  quantity    Decimal @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  // 折扣百分比（100 = 不打折）
  discount    Decimal @default(100) @db.Decimal(5, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  sort        Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

// ============ 合同与回款 ============

enum ContractStatus {
  DRAFT // 草稿
  EXECUTING // 履约中
  COMPLETED // 已完成
  TERMINATED // 已终止
}

model Contract {
  id             String         @id @default(cuid())
  tenantId       String
  code           String
  name           String
  customerId     String
  opportunityId  String?
  quoteId        String?
  amount         Decimal        @default(0) @db.Decimal(14, 2)
  status         ContractStatus @default(DRAFT)
  approvalStatus String         @default("NONE")
  signedAt       DateTime?
  startAt        DateTime?
  endAt          DateTime?
  remark         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  items             ContractItem[]
  receivablePlans   ReceivablePlan[]
  receivableRecords ReceivableRecord[]
  invoices          InvoiceRecord[]
  orders            Order[]

  @@unique([tenantId, code])
  @@index([tenantId, customerId])
  @@index([tenantId, deptId])
  @@map("contracts")
}

model ContractItem {
  id          String  @id @default(cuid())
  contractId  String
  productId   String?
  productName String
  unit        String?
  quantity    Decimal @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(100) @db.Decimal(5, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  sort        Int     @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_items")
}

model ReceivablePlan {
  id         String   @id @default(cuid())
  tenantId   String
  contractId String
  period     Int
  amount     Decimal  @default(0) @db.Decimal(14, 2)
  dueDate    DateTime
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contract Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  records  ReceivableRecord[]

  @@index([tenantId, contractId])
  @@index([tenantId, dueDate])
  @@map("receivable_plans")
}

model ReceivableRecord {
  id             String   @id @default(cuid())
  tenantId       String
  contractId     String
  planId         String?
  amount         Decimal  @default(0) @db.Decimal(14, 2)
  receivedAt     DateTime
  method         String?
  remark         String?
  approvalStatus String   @default("NONE")
  ownerId        String?
  deptId         String?
  createdAt      DateTime @default(now())

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  plan     ReceivablePlan? @relation(fields: [planId], references: [id])

  @@index([tenantId, contractId])
  @@map("receivable_records")
}

// ============ 工商抬头与发票 ============

model InvoiceTitle {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  name        String
  taxNo       String
  bankName    String?
  bankAccount String?
  address     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices InvoiceRecord[]

  @@index([tenantId, customerId])
  @@map("invoice_titles")
}

enum InvoiceStatus {
  PENDING // 待开票
  ISSUED // 已开票
  VOID // 已作废
}

model InvoiceRecord {
  id         String        @id @default(cuid())
  tenantId   String
  contractId String
  titleId    String?
  amount     Decimal       @default(0) @db.Decimal(14, 2)
  type       String        @default("增值税普通发票")
  status     InvoiceStatus @default(PENDING)
  invoiceNo  String?
  issuedAt   DateTime?
  remark     String?
  ownerId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  contract Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title    InvoiceTitle? @relation(fields: [titleId], references: [id])

  @@index([tenantId, contractId])
  @@map("invoice_records")
}

// ============ 订单（合同履约执行） ============

enum OrderStatus {
  PENDING // 待交付
  DELIVERING // 交付中
  ACCEPTED // 已验收
  COMPLETED // 已完成
  CANCELED // 已取消
}

model Order {
  id             String      @id @default(cuid())
  tenantId       String
  code           String
  name           String
  contractId     String
  amount         Decimal     @default(0) @db.Decimal(14, 2)
  status         OrderStatus @default(PENDING)
  approvalStatus String      @default("NONE")
  deliveredAt    DateTime?
  acceptedAt     DateTime?
  remark         String?
  ownerId        String?
  deptId         String?
  customData     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, contractId])
  @@index([tenantId, deptId])
  @@map("orders")
}

// ============ 审批流引擎 ============

// 审批人策略
enum ApproverType {
  USER // 指定成员
  ROLE // 指定角色（该角色全部成员）
  DEPT_LEADER // 发起人部门主管
  DIRECT_LEADER // 发起人直属上级
}

// 多审批人模式
enum ApprovalMode {
  ALL // 会签（全部通过）
  ANY // 或签（任一通过）
}

enum ApprovalFormType {
  QUOTATION
  CONTRACT
  INVOICE
  ORDER
  // 仅用于保留 W2.5 前历史回款审批配置，不对配置 API 暴露。
  RECEIVABLE_RECORD_LEGACY
}

enum ApprovalExecuteTiming {
  CREATE
  UPDATE
  DELETE
}

enum ApprovalNodeType {
  START
  APPROVER
  CONDITION
  DEFAULT
  END
}

enum DuplicateApproverRule {
  FIRST_ONLY
  SEQUENTIAL_ALL
  EACH
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalTaskType {
  APPROVAL
  CC
}

model ApprovalFlow {
  id                    String                @id @default(cuid())
  tenantId              String
  number                String
  formType              ApprovalFormType
  currentVersionId      String?
  name                  String
  createExecute         Boolean               @default(true)
  updateExecute         Boolean               @default(false)
  deleteExecute         Boolean               @default(false)
  submitterCanRevoke    Boolean               @default(true)
  allowBatchProcess     Boolean               @default(false)
  allowWithdraw         Boolean               @default(false)
  allowAddSign          Boolean               @default(false)
  duplicateApproverRule DuplicateApproverRule @default(FIRST_ONLY)
  requireComment        Boolean               @default(false)
  enabled               Boolean               @default(false)
  description           String?               @db.VarChar(1000)
  // 触发条件：{ amountGte?: number }，不满足条件则无需审批
  condition             Json?
  deletedAt             DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  currentVersion ApprovalFlowVersion?  @relation("CurrentFlowVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ApprovalFlowVersion[] @relation("FlowVersions")
  instances      ApprovalInstance[]

  @@unique([tenantId, number])
  @@index([tenantId, formType, deletedAt])
  @@index([tenantId, enabled, deletedAt])
  @@map("approval_flows")
}

model ApprovalFlowNumberCounter {
  id        String           @id @default(cuid())
  tenantId  String
  formType  ApprovalFormType
  nextValue Int              @default(1)
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, formType])
  @@map("approval_flow_number_counters")
}

model ApprovalFlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  tenantId    String
  version     Int
  createdById String?
  createdAt   DateTime @default(now())

  flow            ApprovalFlow       @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Restrict)
  currentForFlows ApprovalFlow[]     @relation("CurrentFlowVersion")
  nodes           ApprovalNode[]
  links           ApprovalNodeLink[]
  instances       ApprovalInstance[]

  @@unique([flowId, version])
  @@index([tenantId, flowId])
  @@map("approval_flow_versions")
}

model ApprovalNode {
  id            String                @id @default(cuid())
  flowVersionId String
  number        String
  name          String
  nodeType      ApprovalNodeType
  executeTiming ApprovalExecuteTiming @default(CREATE)
  sort          Int                   @default(0)

  flowVersion   ApprovalFlowVersion   @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  approver      ApprovalNodeApprover?
  outgoingLinks ApprovalNodeLink[]    @relation("ApprovalNodeOutgoing")
  incomingLinks ApprovalNodeLink[]    @relation("ApprovalNodeIncoming")

  @@unique([flowVersionId, number])
  @@index([flowVersionId, executeTiming, sort])
  @@map("approval_nodes")
}

model ApprovalNodeApprover {
  id           String       @id @default(cuid())
  nodeId       String       @unique
  approverType ApproverType
  // USER=用户ID集合；ROLE=角色ID集合
  approverIds  String[]     @default([])
  ccUserIds    String[]     @default([]) @map("cc_user_ids")
  mode         ApprovalMode @default(ANY)

  node ApprovalNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@map("approval_node_approvers")
}

model ApprovalNodeLink {
  id            String @id @default(cuid())
  flowVersionId String
  fromNodeId    String
  toNodeId      String
  sort          Int    @default(0)

  flowVersion ApprovalFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  fromNode    ApprovalNode        @relation("ApprovalNodeOutgoing", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode      ApprovalNode        @relation("ApprovalNodeIncoming", fields: [toNodeId], references: [id], onDelete: Restrict)

  @@unique([flowVersionId, fromNodeId, toNodeId])
  @@index([flowVersionId, sort])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("approval_node_links")
}

model ApprovalInstance {
  id               String                 @id @default(cuid())
  tenantId         String
  flowId           String?
  flowVersionId    String?
  executeTiming    ApprovalExecuteTiming  @default(CREATE)
  module           String
  targetId         String
  targetName       String
  // 摘要（金额等，用于列表展示）
  summary          String?
  status           ApprovalInstanceStatus @default(PENDING)
  currentNodeIndex Int                    @default(0)
  // 节点快照（提交时冻结流程配置）：[{ name, approverType, mode, approverIds }]
  nodesSnapshot    Json
  submitterId      String
  submitterName    String
  finishedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  flow        ApprovalFlow?        @relation(fields: [flowId], references: [id], onDelete: SetNull)
  flowVersion ApprovalFlowVersion? @relation(fields: [flowVersionId], references: [id], onDelete: SetNull)
  tasks       ApprovalTask[]

  @@index([tenantId, status])
  @@index([tenantId, module, targetId])
  @@index([tenantId, submitterId])
  @@index([flowId, status])
  @@index([flowVersionId])
  @@map("approval_instances")
}

model ApprovalTask {
  id         String             @id @default(cuid())
  tenantId   String
  instanceId String
  nodeIndex  Int
  nodeName   String
  approverId String
  taskType   ApprovalTaskType   @default(APPROVAL) @map("task_type")
  status     ApprovalTaskStatus @default(PENDING)
  comment    String?
  handledAt  DateTime?
  createdAt  DateTime           @default(now())

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, approverId, status])
  @@index([tenantId, approverId, taskType, status])
  @@index([instanceId])
  @@map("approval_tasks")
}

// ============ 标讯（招投标信息） ============

model BiddingSource {
  id          String    @id @default(cuid())
  tenantId    String
  // 适配器标识：demo / jianyu / qianlima ...
  provider    String
  name        String
  // 数据源凭证（API Key 等）
  credentials Json?
  enabled     Boolean   @default(false)
  lastFetchAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, provider])
  @@map("bidding_sources")
}

model BiddingKeywordSub {
  id        String   @id @default(cuid())
  tenantId  String
  keyword   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, keyword])
  @@map("bidding_keyword_subs")
}

model BiddingInfo {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  // 公告类型：招标公告/中标公告/更正公告等
  type            String?
  region          String?
  buyer           String?
  budget          Decimal?  @db.Decimal(16, 2)
  publishedAt     DateTime?
  deadline        DateTime?
  sourceUrl       String?
  content         String?
  // 来源：demo/manual/...
  source          String?
  keyword         String?
  // 去重指纹（标题+发布日期）
  hash            String
  convertedLeadId String?
  createdAt       DateTime  @default(now())

  @@unique([tenantId, hash])
  @@index([tenantId, publishedAt])
  @@map("bidding_infos")
}

// ============ 订阅/套餐（商业化预留，内部阶段不启用计费逻辑） ============

model Plan {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  price     Decimal  @default(0) @db.Decimal(10, 2)
  maxUsers  Int      @default(10)
  features  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ============ Cordys 模块表单与动态字段定义 ============

model SysModuleForm {
  id             String @id @default(cuid()) @db.VarChar(32)
  formKey        String @map("form_key") @db.VarChar(50)
  organizationId String @map("organization_id") @db.VarChar(32)
  createTime     BigInt @map("create_time")
  updateTime     BigInt @map("update_time")
  createUser     String @map("create_user") @db.VarChar(32)
  updateUser     String @map("update_user") @db.VarChar(32)

  blob   SysModuleFormBlob?
  fields SysModuleField[]

  @@unique([organizationId, formKey])
  @@index([organizationId])
  @@map("sys_module_form")
}

model SysModuleFormBlob {
  id   String  @id @db.VarChar(32)
  prop String? @db.Text

  form SysModuleForm @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("sys_module_form_blob")
}

model SysModuleField {
  id          String  @id @default(cuid()) @db.VarChar(32)
  formId      String  @map("form_id") @db.VarChar(32)
  internalKey String? @map("internal_key") @db.VarChar(255)
  name        String  @db.VarChar(255)
  type        String  @db.VarChar(20)
  mobile      Boolean @default(false)
  pos         BigInt
  createUser  String  @map("create_user") @db.VarChar(32)
  createTime  BigInt  @map("create_time")
  updateUser  String  @map("update_user") @db.VarChar(32)
  updateTime  BigInt  @map("update_time")

  form SysModuleForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  blob SysModuleFieldBlob?

  @@index([formId, internalKey])
  @@index([mobile])
  @@map("sys_module_field")
}

model SysModuleFieldBlob {
  id   String  @id @db.VarChar(32)
  prop String? @db.Text

  field SysModuleField @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("sys_module_field_blob")
}

// ============ Cordys 用户视图 ============

model SysUserView {
  id             String  @id @default(cuid()) @db.VarChar(32)
  userId         String  @map("user_id") @db.VarChar(32)
  name           String  @db.VarChar(255)
  fixed          Boolean @default(false)
  resourceType   String  @map("resource_type") @db.VarChar(50)
  organizationId String  @map("organization_id") @db.VarChar(32)
  pos            BigInt
  enable         Boolean @default(true)
  searchMode     String  @default("AND") @map("search_mode") @db.VarChar(10)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)

  conditions SysUserViewCondition[]

  @@unique([organizationId, userId, resourceType, name])
  @@index([userId])
  @@index([name])
  @@index([resourceType])
  @@index([organizationId])
  @@map("sys_user_view")
}

model SysUserViewCondition {
  id            String  @id @default(cuid()) @db.VarChar(32)
  sysUserViewId String  @map("sys_user_view_id") @db.VarChar(32)
  name          String  @db.VarChar(255)
  value         String? @db.Text
  valueType     String? @map("value_type") @db.Text
  type          String? @db.VarChar(20)
  multipleValue Boolean @default(false) @map("multiple_value")
  operator      String? @db.VarChar(20)
  childrenValue String? @map("children_value") @db.Text
  createTime    BigInt  @map("create_time")
  updateTime    BigInt  @map("update_time")
  createUser    String  @map("create_user") @db.VarChar(32)
  updateUser    String  @map("update_user") @db.VarChar(32)

  view SysUserView @relation(fields: [sysUserViewId], references: [id], onDelete: Cascade)

  @@index([sysUserViewId])
  @@map("sys_user_view_condition")
}

// ============ Cordys 仪表板目录、资源与收藏 ============

model DashboardModule {
  id             String @id @default(cuid()) @db.VarChar(32)
  organizationId String @map("organization_id") @db.VarChar(32)
  name           String @db.VarChar(255)
  parentId       String @default("NONE") @map("parent_id") @db.VarChar(32)
  pos            BigInt @default(0)
  createTime     BigInt @map("create_time")
  updateTime     BigInt @map("update_time")
  createUser     String @map("create_user") @db.VarChar(32)
  updateUser     String @map("update_user") @db.VarChar(32)

  dashboards Dashboard[]

  @@index([organizationId])
  @@index([name])
  @@index([pos])
  @@index([parentId])
  @@map("dashboard_module")
}

model Dashboard {
  id                String  @id @default(cuid()) @db.VarChar(32)
  name              String  @db.VarChar(255)
  resourceUrl       String  @map("resource_url") @db.VarChar(500)
  dashboardModuleId String  @map("dashboard_module_id") @db.VarChar(32)
  organizationId    String  @map("organization_id") @db.VarChar(32)
  pos               BigInt  @default(0)
  scopeId           String  @map("scope_id") @db.Text
  description       String? @db.VarChar(1000)
  createTime        BigInt  @map("create_time")
  updateTime        BigInt  @map("update_time")
  createUser        String  @map("create_user") @db.VarChar(32)
  updateUser        String  @map("update_user") @db.VarChar(32)

  module      DashboardModule       @relation(fields: [dashboardModuleId], references: [id], onDelete: Cascade)
  collections DashboardCollection[]

  @@index([name])
  @@index([dashboardModuleId])
  @@index([organizationId])
  @@map("dashboard")
}

model DashboardCollection {
  id          String @id @default(cuid()) @db.VarChar(32)
  userId      String @map("user_id") @db.VarChar(32)
  dashboardId String @map("dashboard_id") @db.VarChar(32)
  createTime  BigInt @map("create_time")
  updateTime  BigInt @map("update_time")
  createUser  String @map("create_user") @db.VarChar(32)
  updateUser  String @map("update_user") @db.VarChar(32)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([userId, dashboardId])
  @@index([userId])
  @@map("dashboard_collection")
}

// ============ 系统：日志 / 通知 / 设置 / 附件 ============

model OperationLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userName   String?
  module     String
  action     String
  targetId   String?
  targetName String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, module])
  @@map("operation_logs")
}

model LoginLog {
  id                 String   @id @default(cuid())
  tenantId           String?
  userId             String?
  email              String
  authType           String   @default("PASSWORD")
  externalSubject    String?
  externalIdentityId String?
  ip                 String?
  userAgent          String?
  success            Boolean
  message            String?
  createdAt          DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, authType, createdAt])
  @@map("login_logs")
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  // 业务类型：assign / approval / receivable / pool / follow_plan / system
  type      String
  title     String
  content   String?
  // 前端跳转路由
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model MessageTaskSetting {
