  tenantId     String
  targetType   String
  targetId     String
  type         String
  content      String
  nextFollowAt DateTime?
  ownerId      String
  ownerName    String
  createdAt    DateTime  @default(now())

  @@index([tenantId, targetType, targetId])
  @@map("follow_up_records")
}

enum FollowUpPlanStatus {
  PREPARED
  UNDERWAY
  COMPLETED
  CANCELLED
}

// ============ 跟进计划（多态：线索/客户/商机） ============

model FollowUpPlan {
  id                String             @id @default(cuid())
  tenantId          String
  targetType        String
  targetId          String
  contactId         String?
  content           String
  method            String?
  estimatedAt       DateTime?
  status            FollowUpPlanStatus @default(PREPARED)
  converted         Boolean            @default(false)
  convertedRecordId String?
  ownerId           String
  deptId            String?
