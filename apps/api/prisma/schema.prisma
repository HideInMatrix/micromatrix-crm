  tenantId      String
  module        String
  event         String
  systemEnabled Boolean  @default(true)
  emailEnabled  Boolean  @default(false)
  weComEnabled  Boolean  @default(false)
  config        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, event])
  @@index([tenantId, module])
  @@map("message_task_settings")
}

model EnterpriseUiSetting {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  theme                    String   @default("default")
  customTheme              String   @default("#008d91")
  style                    String   @default("default")
  customStyle              String   @default("#f9fbfb")
