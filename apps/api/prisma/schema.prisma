  registeredCapital    String? @map("registered_capital") @db.VarChar(255)
  companySize          String? @map("company_size") @db.VarChar(255)
  registrationNumber   String? @map("registration_number") @db.VarChar(255)
  approvalStatus       String? @map("approval_status") @db.VarChar(50)
  unapprovedReason     String? @map("unapproved_reason") @db.VarChar(255)
  organizationId       String  @map("organization_id") @db.VarChar(50)
  province             String? @db.VarChar(255)
  city                 String? @db.VarChar(255)
  scale                String? @db.VarChar(255)
  industry             String? @db.VarChar(255)
  remark               String? @db.VarChar(255)
  companyNumber        BigInt  @unique @default(autoincrement()) @map("company_number")
  createTime           BigInt  @map("create_time")
  updateTime           BigInt  @map("update_time")
  createUser           String  @map("create_user") @db.VarChar(32)
  updateUser           String  @map("update_user") @db.VarChar(32)

  contractInvoices ContractInvoice[]

  @@index([organizationId])
  @@index([name])
  @@map("business_title")
}

model BusinessTitleConfig {
  id             String  @id @default(cuid()) @db.VarChar(32)
  field          String  @db.VarChar(255)
  required       Boolean @default(true)
  organizationId String  @map("organization_id") @db.VarChar(32)

  @@unique([organizationId, field])
  @@index([organizationId])
  @@map("business_title_config")
}

model ContractInvoice {
  id              String   @id @default(cuid()) @db.VarChar(32)
  name            String   @db.VarChar(255)
  contractId      String   @map("contract_id") @db.VarChar(32)
  owner           String   @db.VarChar(32)
  amount          Decimal? @db.Decimal(20, 10)
  invoiceType     String?  @map("invoice_type") @db.VarChar(32)
  taxRate         Decimal? @map("tax_rate") @db.Decimal(20, 10)
  approvalStatus  String?  @map("approval_status") @db.VarChar(32)
  businessTitleId String?  @map("business_title_id") @db.VarChar(32)
  organizationId  String   @map("organization_id") @db.VarChar(32)
  approved        Boolean  @default(false)
  createTime      BigInt   @map("create_time")
  updateTime      BigInt   @map("update_time")
  createUser      String   @map("create_user") @db.VarChar(32)
  updateUser      String   @map("update_user") @db.VarChar(32)

  contract        Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  businessTitle   BusinessTitle?             @relation(fields: [businessTitleId], references: [id], onDelete: SetNull)
  fieldValues     ContractInvoiceField[]
  fieldBlobValues ContractInvoiceFieldBlob[]
  snapshots       ContractInvoiceSnapshot[]

  @@index([contractId])
  @@index([owner])
  @@index([organizationId])
  @@index([approvalStatus])
  @@index([createUser])
  @@map("contract_invoice")
}

model ContractInvoiceField {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.VarChar(255)

  resource ContractInvoice @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId, fieldId, fieldValue])
  @@map("contract_invoice_field")
}

model ContractInvoiceFieldBlob {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.Text

  resource ContractInvoice @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId])
  @@map("contract_invoice_field_blob")
}

model ContractInvoiceSnapshot {
  id           String  @id @default(cuid()) @db.VarChar(32)
  invoiceId    String  @map("invoice_id") @db.VarChar(32)
  invoiceProp  String? @map("invoice_prop") @db.Text
  invoiceValue String? @map("invoice_value") @db.Text

  invoice ContractInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("contract_invoice_snapshot")
}

model Order {
  id             String   @id @default(cuid()) @db.VarChar(32)
  number         String   @db.VarChar(50)
  name           String   @db.VarChar(255)
  customerId     String?  @map("customer_id") @db.VarChar(32)
  contractId     String?  @map("contract_id") @db.VarChar(32)
  owner          String?  @db.VarChar(32)
  amount         Decimal? @db.Decimal(20, 10)
  stage          String   @db.VarChar(50)
  approvalStatus String   @default("NONE") @map("approval_status") @db.VarChar(50)
  organizationId String   @map("organization_id") @db.VarChar(32)
  pos            BigInt?
  approved       Boolean  @default(false)
  createTime     BigInt   @map("create_time")
  updateTime     BigInt   @map("update_time")
  createUser     String   @map("create_user") @db.VarChar(32)
  updateUser     String   @map("update_user") @db.VarChar(32)

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contract        Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  fieldValues     OrderField[]
  fieldBlobValues OrderFieldBlob[]
  snapshots       OrderSnapshot[]

  @@index([customerId])
  @@index([contractId])
  @@index([owner])
  @@index([name])
  @@index([number])
  @@index([organizationId])
  @@index([approvalStatus])
  @@index([stage])
  @@index([createUser])
  @@map("sales_order")
}

model OrderField {
  id         String  @id @default(cuid()) @db.VarChar(32)
  resourceId String  @map("resource_id") @db.VarChar(32)
  fieldId    String  @map("field_id") @db.VarChar(32)
  fieldValue String  @map("field_value") @db.VarChar(255)
  refSubId   String? @map("ref_sub_id") @db.VarChar(32)
  rowId      String? @map("row_id") @db.VarChar(32)
  bizId      String? @map("biz_id") @db.VarChar(32)

  resource Order @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, refSubId, rowId, fieldId], map: "uk_order_field_cell")
  @@index([resourceId])
  @@index([refSubId])
  @@map("sales_order_field")
}

model OrderFieldBlob {
  id         String  @id @default(cuid()) @db.VarChar(32)
  resourceId String  @map("resource_id") @db.VarChar(32)
  fieldId    String  @map("field_id") @db.VarChar(32)
  fieldValue String  @map("field_value") @db.Text
  refSubId   String? @map("ref_sub_id") @db.VarChar(32)
  rowId      String? @map("row_id") @db.VarChar(32)
  bizId      String? @map("biz_id") @db.VarChar(32)

  resource Order @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, refSubId, rowId, fieldId], map: "uk_order_field_blob_cell")
  @@index([resourceId])
  @@index([refSubId])
  @@map("sales_order_field_blob")
}

model OrderSnapshot {
  id         String  @id @default(cuid()) @db.VarChar(32)
  orderId    String  @map("order_id") @db.VarChar(32)
  orderProp  String? @map("order_prop") @db.Text
  orderValue String? @map("order_value") @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("sales_order_snapshot")
}

model OrderStageConfig {
  id              String  @id @default(cuid()) @db.VarChar(32)
  name            String  @db.VarChar(255)
  type            String  @db.VarChar(50)
  afootRollBack   Boolean @default(true) @map("afoot_roll_back")
  endRollBack     Boolean @default(false) @map("end_roll_back")
  pos             BigInt
  organizationId  String  @map("organization_id") @db.VarChar(32)
  circulationType String  @default("NORMAL") @map("circulation_type") @db.VarChar(50)
  createTime      BigInt  @map("create_time")
  updateTime      BigInt  @map("update_time")
  createUser      String  @map("create_user") @db.VarChar(32)
  updateUser      String  @map("update_user") @db.VarChar(32)

  @@index([organizationId, pos])
  @@map("sales_order_stage_config")
}

// ============ 审批流引擎 ============

// 审批人策略
enum ApproverType {
  USER // 指定成员
  ROLE // 指定角色（该角色全部成员）
  DEPT_LEADER // 发起人部门主管
  DIRECT_LEADER // 发起人直属上级
  MULTIPLE_DEPT_LEADER // 连续多级部门主管
  MULTIPLE_DIRECT_LEADER // 连续多级直属上级
}

// 多审批人模式
enum ApprovalMode {
  ALL // 会签（全部通过）
  ANY // 或签（任一通过）
}

enum EmptyApproverAction {
  AUTO_PASS
  ASSIGN_SPECIFIC
  ASSIGN_ADMIN
}

enum SameSubmitterAction {
  SKIP
  ALLOW
  ASSIGN_SUPERIOR
}

enum ApproverDirection {
  BOTTOM_UP
  TOP_DOWN
}

enum ApprovalFormType {
  QUOTATION
  CONTRACT
  INVOICE
  ORDER
  // 仅用于保留 W2.5 前历史回款审批配置，不对配置 API 暴露。
  RECEIVABLE_RECORD_LEGACY
}

enum ApprovalExecuteTiming {
  CREATE
  UPDATE
  DELETE
}

enum ApprovalNodeType {
  START
  APPROVER
  CONDITION
  DEFAULT
  END
}

enum DuplicateApproverRule {
  FIRST_ONLY
  SEQUENTIAL_ALL
  EACH
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalTaskType {
  APPROVAL
  CC
  SIGN
  BACK
}

enum ApprovalTaskAction {
  APPROVE
  REJECT
  SIGN
  BACK
}

enum ApprovalAddSignType {
  BEFORE
  AFTER
}

enum ApprovalWebhookDeliverySource {
  TEST
  RUNTIME
}

enum ApprovalWebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model ApprovalFlow {
  id                    String                @id @default(cuid())
  tenantId              String
  number                String
  formType              ApprovalFormType
  currentVersionId      String?
  name                  String
  createExecute         Boolean               @default(true)
  updateExecute         Boolean               @default(false)
  deleteExecute         Boolean               @default(false)
  submitterCanRevoke    Boolean               @default(true)
  allowBatchProcess     Boolean               @default(false)
  allowWithdraw         Boolean               @default(false)
  allowAddSign          Boolean               @default(false)
  duplicateApproverRule DuplicateApproverRule @default(FIRST_ONLY)
  requireComment        Boolean               @default(false)
  enabled               Boolean               @default(false)
  description           String?               @db.VarChar(1000)
  // 触发条件：{ amountGte?: number }，不满足条件则无需审批
  condition             Json?
  deletedAt             DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  currentVersion ApprovalFlowVersion?  @relation("CurrentFlowVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ApprovalFlowVersion[] @relation("FlowVersions")
  instances      ApprovalInstance[]

  @@unique([tenantId, number])
  @@index([tenantId, formType, deletedAt])
  @@index([tenantId, enabled, deletedAt])
  @@map("approval_flows")
}

model ApprovalFlowNumberCounter {
  id        String           @id @default(cuid())
  tenantId  String
  formType  ApprovalFormType
  nextValue Int              @default(1)
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, formType])
  @@map("approval_flow_number_counters")
}

model ApprovalFlowVersion {
  id          String   @id @default(cuid())
  flowId      String
  tenantId    String
  version     Int
  createdById String?
  createdAt   DateTime @default(now())

  flow            ApprovalFlow            @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Restrict)
  currentForFlows ApprovalFlow[]          @relation("CurrentFlowVersion")
  nodes           ApprovalNode[]
  links           ApprovalNodeLink[]
  conditions      ApprovalNodeCondition[]
  instances       ApprovalInstance[]

  @@unique([flowId, version])
  @@index([tenantId, flowId])
  @@map("approval_flow_versions")
}

model ApprovalNode {
  id            String                @id @default(cuid())
  flowVersionId String
  number        String
  name          String
  nodeType      ApprovalNodeType
  executeTiming ApprovalExecuteTiming @default(CREATE)
  sort          Int                   @default(0)

  flowVersion   ApprovalFlowVersion    @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  approver      ApprovalNodeApprover?
  condition     ApprovalNodeCondition?
  outgoingLinks ApprovalNodeLink[]     @relation("ApprovalNodeOutgoing")
  incomingLinks ApprovalNodeLink[]     @relation("ApprovalNodeIncoming")

  @@unique([flowVersionId, number])
  @@index([flowVersionId, executeTiming, sort])
  @@map("approval_nodes")
}

model ApprovalNodeApprover {
  id                  String              @id @default(cuid())
  nodeId              String              @unique
  approverType        ApproverType
  // USER=用户ID集合；ROLE=角色ID集合；层级类型保存 1~10 的层级值。
  approverIds         String[]            @default([])
  ccUserIds           String[]            @default([]) @map("cc_user_ids")
  mode                ApprovalMode        @default(ANY)
  emptyApproverAction EmptyApproverAction @default(AUTO_PASS) @map("empty_approver_action")
  fallbackApprover    String?             @map("fallback_approver")
  sameSubmitterAction SameSubmitterAction @default(SKIP) @map("same_submitter_action")
  approverDirection   ApproverDirection   @default(BOTTOM_UP) @map("approver_direction")
  fieldPermissions    Json?               @map("field_permissions")
  passPostConfig      Json?               @map("pass_post_config")
  rejectPostConfig    Json?               @map("reject_post_config")

  node ApprovalNode @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@map("approval_node_approvers")
}

model ApprovalNodeCondition {
  id              String @id
  flowVersionId   String
  conditionConfig Json?  @map("condition_config")

  node        ApprovalNode        @relation(fields: [id], references: [id], onDelete: Restrict)
  flowVersion ApprovalFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)

  @@index([flowVersionId])
  @@map("approval_node_conditions")
}

model ApprovalNodeLink {
  id            String @id @default(cuid())
  flowVersionId String
  fromNodeId    String
  toNodeId      String
  sort          Int    @default(0)

  flowVersion ApprovalFlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  fromNode    ApprovalNode        @relation("ApprovalNodeOutgoing", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode      ApprovalNode        @relation("ApprovalNodeIncoming", fields: [toNodeId], references: [id], onDelete: Restrict)

  @@unique([flowVersionId, fromNodeId, toNodeId])
  @@index([flowVersionId, sort])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("approval_node_links")
}

model ApprovalInstance {
  id               String                 @id @default(cuid())
  tenantId         String
  flowId           String?
  flowVersionId    String?
  executeTiming    ApprovalExecuteTiming  @default(CREATE)
  module           String
  targetId         String
  targetName       String
  // 摘要（金额等，用于列表展示）
  summary          String?
  status           ApprovalInstanceStatus @default(PENDING)
  currentNodeIndex Int                    @default(0)
  // 节点快照（提交时冻结流程配置）：[{ name, approverType, mode, approverIds }]
  nodesSnapshot    Json
  // Cordys approval_instance.comment：实例级提交说明，不等同于任务审批意见。
  comment          String?
  // Cordys approval_instance.update_fields：JSON 字符串形式的本次编辑字段 ID 列表。
  updateFields     String?                @map("update_fields") @db.VarChar(2000)
  submitterId      String
  submitterName    String
  finishedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  flow              ApprovalFlow?                @relation(fields: [flowId], references: [id], onDelete: SetNull)
  flowVersion       ApprovalFlowVersion?         @relation(fields: [flowVersionId], references: [id], onDelete: SetNull)
  tasks             ApprovalTask[]
  records           ApprovalRecord[]
  addSignTasks      ApprovalAddSignTask[]
  returnBackRecords ApprovalReturnBackRecord[]
  attachments       ApprovalInstanceAttachment[]
  webhookDeliveries ApprovalWebhookDelivery[]

  @@index([tenantId, status])
  @@index([tenantId, module, targetId])
  @@index([tenantId, submitterId])
  @@index([flowId, status])
  @@index([flowVersionId])
  @@map("approval_instances")
}

model ApprovalResourceSnapshot {
  id           String           @id @default(cuid())
  tenantId     String
  formType     ApprovalFormType
  resourceId   String
  snapshotData Json             @map("snapshot_data")
  createdById  String?          @map("created_by_id")
  updatedById  String?          @map("updated_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, formType, resourceId])
  @@index([tenantId, formType])
  @@map("approval_resource_snapshots")
}

model ApprovalTask {
  id         String              @id @default(cuid())
  tenantId   String
  instanceId String
  nodeId     String?             @map("node_id")
  nodeIndex  Int
  nodeRound  Int                 @default(1) @map("node_round")
  nodeName   String
  approverId String
  taskType   ApprovalTaskType    @default(APPROVAL) @map("task_type")
  status     ApprovalTaskStatus  @default(PENDING)
  action     ApprovalTaskAction?
  handledAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  instance          ApprovalInstance           @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  records           ApprovalRecord[]
  addSignTask       ApprovalAddSignTask?       @relation("AddSignCreatedTask")
  signedByTasks     ApprovalAddSignTask[]      @relation("AddSignSourceTask")
  returnBackRecords ApprovalReturnBackRecord[]

  @@index([tenantId, approverId, status])
  @@index([tenantId, approverId, taskType, status])
  @@index([instanceId])
  @@index([instanceId, nodeIndex, nodeRound])
  @@map("approval_tasks")
}

model ApprovalAddSignTask {
  id          String              @id @default(cuid())
  tenantId    String
  instanceId  String
  taskId      String              @unique @map("task_id")
  signTaskId  String              @map("sign_task_id")
  type        ApprovalAddSignType
  rootTaskId  String              @map("root_task_id")
  sort        BigInt
  comment     String?
  createdById String              @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  task     ApprovalTask     @relation("AddSignCreatedTask", fields: [taskId], references: [id], onDelete: Cascade)
  signTask ApprovalTask     @relation("AddSignSourceTask", fields: [signTaskId], references: [id], onDelete: Cascade)

  @@index([tenantId, instanceId])
  @@index([rootTaskId, sort])
  @@index([signTaskId])
  @@map("approval_add_sign_tasks")
}

model ApprovalRecord {
  id          String             @id @default(cuid())
  tenantId    String
  instanceId  String
  taskId      String?
  nodeId      String?            @map("node_id")
  nodeRound   Int                @default(1) @map("node_round")
  result      ApprovalTaskAction
  comment     String?
  createdById String             @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  task     ApprovalTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, instanceId, createdAt])
  @@index([taskId])
  @@map("approval_records")
}

model ApprovalReturnBackRecord {
  id             String   @id @default(cuid())
  tenantId       String
  instanceId     String   @map("instance_id")
  taskId         String   @map("task_id")
  returnToNodeId String   @map("return_to_node_id")
  returnReason   String?  @map("return_reason")
  returnUserId   String   @map("return_user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  task     ApprovalTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([instanceId, returnToNodeId])
  @@index([tenantId, instanceId, createdAt])
  @@index([taskId])
  @@map("approval_return_back_records")
}

model ApprovalInstanceAttachment {
  id           String   @id @default(cuid())
  tenantId     String
  instanceId   String   @map("instance_id")
  elementId    String   @map("element_id")
  attachmentId String   @map("attachment_id")
  createdAt    DateTime @default(now()) @map("created_at")

  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  attachment Attachment       @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([instanceId, elementId, attachmentId])
  @@index([tenantId, instanceId, createdAt])
  @@index([elementId])
  @@index([attachmentId])
  @@map("approval_instance_attachments")
}

model ApprovalWebhookDelivery {
  id            String                        @id @default(cuid())
  tenantId      String                        @map("tenant_id")
  instanceId    String?                       @map("instance_id")
  flowId        String?                       @map("flow_id")
  flowVersionId String?                       @map("flow_version_id")
  nodeId        String?                       @map("node_id")
  nodeIndex     Int?                          @map("node_index")
  action        String?
  source        ApprovalWebhookDeliverySource
  method        String
  targetOrigin  String                        @map("target_origin")
  targetPath    String                        @map("target_path")
  status        ApprovalWebhookDeliveryStatus @default(PENDING)
  httpStatus    Int?                          @map("http_status")
  responseBytes Int?                          @map("response_bytes")
  durationMs    Int?                          @map("duration_ms")
  errorCode     String?                       @map("error_code") @db.VarChar(64)
  errorMessage  String?                       @map("error_message") @db.VarChar(500)
  createdById   String?                       @map("created_by_id")
  startedAt     DateTime?                     @map("started_at")
  finishedAt    DateTime?                     @map("finished_at")
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @updatedAt @map("updated_at")

  instance ApprovalInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, instanceId, createdAt])
  @@index([tenantId, flowId, createdAt])
  @@map("approval_webhook_deliveries")
}

// ============ 标讯（招投标信息） ============

model BiddingSource {
  id          String    @id @default(cuid())
  tenantId    String
  // 适配器标识：demo / jianyu / qianlima ...
  provider    String
  name        String
  // 数据源凭证（API Key 等）
  credentials Json?
  enabled     Boolean   @default(false)
  lastFetchAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, provider])
  @@map("bidding_sources")
}

model BiddingKeywordSub {
  id        String   @id @default(cuid())
  tenantId  String
  keyword   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, keyword])
  @@map("bidding_keyword_subs")
}

model BiddingInfo {
  id              String    @id @default(cuid())
  tenantId        String
  title           String
  // 公告类型：招标公告/中标公告/更正公告等
  type            String?
  region          String?
  buyer           String?
  budget          Decimal?  @db.Decimal(16, 2)
  publishedAt     DateTime?
  deadline        DateTime?
  sourceUrl       String?
  content         String?
  // 来源：demo/manual/...
  source          String?
  keyword         String?
