  helpDoc                   String   @default("")
  iconAttachmentId         String?
  loginLogoAttachmentId    String?
  loginImageAttachmentId   String?
  platformLogoAttachmentId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("enterprise_ui_settings")
}

model EnterpriseMailSetting {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  host               String
  port               Int
  account            String
  passwordCiphertext String?
  passwordIv         String?
  passwordAuthTag    String?
  passwordKeyVersion Int?
