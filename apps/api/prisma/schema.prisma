// 多租户约定：既有模块继续使用 tenantId；Cordys 直接业务表使用 organizationId。
// 请求鉴权边界负责将 tenantId 解析为同一组织 ID，目标表不同时保留两套组织字段。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // API 是 CommonJS 工程，生成的客户端需保持一致，否则运行时会被 Node 误判为 ESM
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EnterpriseIntegrationProvider {
  WECOM
  DINGTALK
  LARK
}

enum ExternalIdentityStatus {
  ACTIVE
  REVOKED
}

enum ExternalOAuthFlow {
  QR_WECOM
  WECOM
}

enum MessageDeliveryChannel {
  WECOM
  DINGTALK
  LARK
  EMAIL
}

enum MessageDeliveryStatus {
  PENDING
  SENDING
  SUCCEEDED
  FAILED
  DEAD
}

enum OrganizationSyncStatus {
  FETCHING
  PREVIEW_READY
  APPLYING
  SUCCEEDED
  FAILED
  INVALIDATED
}

enum OrganizationSyncResourceType {
  DEPARTMENT
  USER
}

enum OrganizationSyncAction {
  CREATE
  UPDATE
  DISABLE
  UNCHANGED
  CONFLICT
  SKIP
}

enum OrganizationSyncItemResult {
  PENDING
  RESOLVED
  APPLIED
  SKIPPED
  FAILED
}

enum OrganizationSyncResolution {
  BIND
  SKIP
}

// 数据范围（角色的数据可见边界）
enum DataScope {
  ALL // 全部数据
  DEPT_AND_CHILD // 本部门及下级部门
  DEPT // 本部门
  SELF // 仅本人
  CUSTOM // 自定义部门
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users                      User[]
  roles                      Role[]
  userRoles                  UserRole[]
  subscriptions              Subscription[]
  departments                Department[]
  moduleConfigs              ModuleConfig[]
  topNavigationConfigs       TopNavigationConfig[]
  messageTaskSettings        MessageTaskSetting[]
  enterpriseUiSettings       EnterpriseUiSetting[]
  enterpriseMailSettings     EnterpriseMailSetting[]
  enterpriseAiModels         EnterpriseAiModel[]
  enterpriseAiRoutes         EnterpriseAiModelRoute[]
  enterpriseTermCategories   EnterpriseTermCategory[]
  enterpriseTerms            EnterpriseTerm[]
  enterpriseTermDiscoveries  EnterpriseTermDiscovery[]
  enterpriseGlobalTasks      EnterpriseGlobalTask[]
  enterpriseTaskExecutions   EnterpriseGlobalTaskExecution[]
  enterpriseIntegrations     EnterpriseIntegration[]
  externalDepartmentMappings ExternalDepartmentMapping[]
  externalUserMappings       ExternalUserMapping[]
  externalIdentities         ExternalIdentity[]
  externalOAuthStates        ExternalOAuthState[]
  messageDeliveries          MessageDelivery[]
  organizationSyncBatches    OrganizationSyncBatch[]

  @@map("tenants")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  leaderId  String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                      @relation(fields: [tenantId], references: [id])
  parent           Department?                 @relation("DeptTree", fields: [parentId], references: [id])
  children         Department[]                @relation("DeptTree")
  users            User[]
  externalMappings ExternalDepartmentMapping[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("departments")
}

model User {
  id                   String     @id @default(cuid())
  tenantId             String
  email                String?
  passwordHash         String
  name                 String
  status               UserStatus @default(ACTIVE)
  deptId               String?
  // 直属上级（逐级审批的汇报线）
  leaderId             String?
  position             String?
  phone                String?
  // Cordys sys_user.gender：false=男，true=女。
  gender               Boolean    @default(false)
  // 企业微信等外部来源成员在建立统一登录前禁止使用普通密码登录
  passwordLoginEnabled Boolean    @default(true)
  // Cordys 首页默认密码提醒；用户完成密码修改后置 false。
  defaultPwd           Boolean    @default(false) @map("default_pwd")
  // 修改密码后自增，使已签发的 access / refresh 会话立即失效。
  authVersion          Int        @default(0) @map("auth_version")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  tenant             Tenant                @relation(fields: [tenantId], references: [id])
  dept               Department?           @relation(fields: [deptId], references: [id])
  userRoles          UserRole[]
  externalMappings   ExternalUserMapping[]
  externalIdentities ExternalIdentity[]
  messageDeliveries  MessageDelivery[]
  apiKeys            UserApiKey[]
  extension          UserExtension?

  @@index([tenantId])
  @@index([tenantId, deptId])
  @@index([email])
  @@map("users")
}

// 对齐 Cordys user_key：个人中心最多维护 5 个 AK/SK，用于开放 API 请求。
model UserApiKey {
  id          String    @id @default(cuid())
  userId      String    @map("create_user")
  accessKey   String    @unique @map("access_key")
  secretKey   String    @map("secret_key")
  createdAt   DateTime  @default(now()) @map("create_time")
  enabled     Boolean   @default(true) @map("enable")
  forever     Boolean   @default(true)
  expireAt    DateTime? @map("expire_time")
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_key")
}

// 对齐 Cordys sys_user_extend：头像和第三方平台扩展数据不进入用户主表。
model UserExtension {
  id           String  @id
  avatar       String?
  platformInfo Bytes?

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("user_extensions")
}

model Role {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  // 权限码列表（menu:* 为菜单权限，资源:操作 为动作权限），'*' 表示全部权限
  permissions  String[]  @default([])
  // 数据范围与自定义部门（dataScope=CUSTOM 时生效）
  dataScope    DataScope @default(SELF)
  scopeDeptIds String[]  @default([])
  // 系统内置角色（管理员）不可删除/降权
  isSystem     Boolean   @default(false)
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                           Tenant                  @relation(fields: [tenantId], references: [id])
  userRoles                        UserRole[]
  defaultForEnterpriseIntegrations EnterpriseIntegration[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId, roleId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

// ============ Cordys 客户、联系人与公海直接模型 ============

model Customer {
  id             String  @id @default(cuid()) @db.VarChar(32)
  name           String  @db.VarChar(255)
  owner          String? @db.VarChar(32)
  collectionTime BigInt? @map("collection_time")
  poolId         String? @map("pool_id") @db.VarChar(32)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)
  inSharedPool   Boolean @default(false) @map("in_shared_pool")
  organizationId String  @map("organization_id") @db.VarChar(32)
  follower       String? @db.VarChar(32)
  followTime     BigInt? @map("follow_time")
  reasonId       String? @map("reason_id") @db.VarChar(32)

  pool            CustomerPool?           @relation(fields: [poolId], references: [id], onDelete: SetNull)
  fieldValues     CustomerField[]
  fieldBlobValues CustomerFieldBlob[]
  ownerHistory    CustomerOwner[]
  contacts        CustomerContact[]
  collaborations  CustomerCollaboration[]
  sourceRelations CustomerRelation[]      @relation("CustomerRelationSource")
  targetRelations CustomerRelation[]      @relation("CustomerRelationTarget")
  opportunities   Opportunity[]
  quotes          Quote[]
  contracts       Contract[]

  @@index([organizationId])
  @@index([poolId])
  @@index([follower])
  @@index([followTime])
  @@index([reasonId])
  @@map("customer")
}

model CustomerField {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.VarChar(255)

  resource Customer @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId, fieldId, fieldValue])
  @@map("customer_field")
}

model CustomerFieldBlob {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.Text

  resource Customer @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId])
  @@map("customer_field_blob")
}

model CustomerOwner {
  id             String  @id @default(cuid()) @db.VarChar(32)
  customerId     String  @map("customer_id") @db.VarChar(32)
  owner          String  @db.VarChar(32)
  collectionTime BigInt  @map("collection_time")
  endTime        BigInt  @map("end_time")
  operator       String  @db.VarChar(32)
  reasonId       String? @map("reason_id") @db.VarChar(32)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_owner")
}

model CustomerContact {
  id             String  @id @default(cuid()) @db.VarChar(32)
  customerId     String? @map("customer_id") @db.VarChar(32)
  name           String  @db.VarChar(255)
  phone          String? @db.VarChar(30)
  owner          String  @db.VarChar(32)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)
  enable         Boolean @default(false)
  disableReason  String? @map("disable_reason") @db.VarChar(255)
  organizationId String  @map("organization_id") @db.VarChar(32)

  customer        Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fieldValues     CustomerContactField[]
  fieldBlobValues CustomerContactFieldBlob[]
  opportunities   Opportunity[]

  @@index([customerId])
  @@index([organizationId])
  @@index([phone])
  @@map("customer_contact")
}

model CustomerContactField {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.VarChar(255)

  resource CustomerContact @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId, fieldId, fieldValue])
  @@map("customer_contact_field")
}

model CustomerContactFieldBlob {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.Text

  resource CustomerContact @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId])
  @@map("customer_contact_field_blob")
}

model CustomerCollaboration {
  id                String @id @default(cuid()) @db.VarChar(32)
  createTime        BigInt @map("create_time")
  updateTime        BigInt @map("update_time")
  createUser        String @map("create_user") @db.VarChar(32)
  updateUser        String @map("update_user") @db.VarChar(32)
  userId            String @map("user_id") @db.VarChar(32)
  customerId        String @map("customer_id") @db.VarChar(32)
  collaborationType String @map("collaboration_type") @db.VarChar(50)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId])
  @@index([customerId])
  @@index([userId])
  @@map("customer_collaboration")
}

model CustomerRelation {
  id               String @id @default(cuid()) @db.VarChar(32)
  sourceCustomerId String @map("source_customer_id") @db.VarChar(32)
  targetCustomerId String @map("target_customer_id") @db.VarChar(32)
  createTime       BigInt @map("create_time")

  sourceCustomer Customer @relation("CustomerRelationSource", fields: [sourceCustomerId], references: [id], onDelete: Cascade)
  targetCustomer Customer @relation("CustomerRelationTarget", fields: [targetCustomerId], references: [id], onDelete: Cascade)

  @@unique([sourceCustomerId, targetCustomerId])
  @@index([sourceCustomerId])
  @@index([targetCustomerId])
  @@map("customer_relation")
}

model CustomerPool {
  id             String  @id @default(cuid()) @db.VarChar(32)
  scopeId        String  @map("scope_id") @db.Text
  organizationId String  @map("organization_id") @db.VarChar(32)
  name           String  @db.VarChar(255)
  ownerId        String  @map("owner_id") @db.Text
  enable         Boolean @default(true)
  auto           Boolean @default(false)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)

  customers    Customer[]
  hiddenFields CustomerPoolHiddenField[]
  pickRule     CustomerPoolPickRule?
  recycleRule  CustomerPoolRecycleRule?

  @@index([organizationId])
  @@map("customer_pool")
}

model CustomerPoolHiddenField {
  poolId  String @map("pool_id") @db.VarChar(32)
  fieldId String @map("field_id") @db.VarChar(32)

  pool CustomerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, fieldId])
  @@map("customer_pool_hidden_field")
}

model CustomerPoolPickRule {
  id               String  @id @default(cuid()) @db.VarChar(32)
  poolId           String  @unique @map("pool_id") @db.VarChar(32)
  limitOnNumber    Boolean @default(true) @map("limit_on_number")
  pickNumber       Int?    @map("pick_number")
  limitPreOwner    Boolean @default(true) @map("limit_pre_owner")
  pickIntervalDays Int?    @map("pick_interval_days")
  limitNew         Boolean @default(false) @map("limit_new")
  newPickInterval  Int?    @map("new_pick_interval")
  createUser       String  @map("create_user") @db.VarChar(32)
  createTime       BigInt  @map("create_time")
  updateUser       String  @map("update_user") @db.VarChar(32)
  updateTime       BigInt  @map("update_time")

  pool CustomerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("customer_pool_pick_rule")
}

model CustomerPoolRecycleRule {
  id         String  @id @default(cuid()) @db.VarChar(32)
  poolId     String  @unique @map("pool_id") @db.VarChar(32)
  operator   String? @db.VarChar(10)
  condition  String? @db.Text
  createTime BigInt  @map("create_time")
  updateTime BigInt  @map("update_time")
  createUser String  @map("create_user") @db.VarChar(32)
  updateUser String  @map("update_user") @db.VarChar(32)

  pool CustomerPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("customer_pool_recycle_rule")
}

model CustomerCapacity {
  id             String  @id @default(cuid()) @db.VarChar(32)
  organizationId String  @map("organization_id") @db.VarChar(32)
  scopeId        String  @map("scope_id") @db.Text
  capacity       Int?
  filter         String? @db.Text
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)

  @@index([organizationId])
  @@map("customer_capacity")
}

// ============ Cordys 线索与线索池直接模型 ============

model Clue {
  id             String  @id @default(cuid()) @db.VarChar(32)
  name           String  @db.VarChar(255)
  owner          String? @db.VarChar(32)
  lastStage      String? @map("last_stage") @db.VarChar(30)
  stage          String  @db.VarChar(30)
  collectionTime BigInt? @map("collection_time")
  contact        String? @db.VarChar(255)
  phone          String? @db.VarChar(255)
  products       String? @db.VarChar(1000)
  organizationId String  @map("organization_id") @db.VarChar(32)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)
  transitionType String? @default("NONE") @map("transition_type") @db.VarChar(30)
  transitionId   String? @map("transition_id") @db.VarChar(32)
  inSharedPool   Boolean @default(false) @map("in_shared_pool")
  follower       String? @db.VarChar(32)
  followTime     BigInt? @map("follow_time")
  poolId         String? @map("pool_id") @db.VarChar(32)
  reasonId       String? @map("reason_id") @db.VarChar(32)

  pool            CluePool?       @relation(fields: [poolId], references: [id], onDelete: SetNull)
  fieldValues     ClueField[]
  fieldBlobValues ClueFieldBlob[]
  ownerHistory    ClueOwner[]

  @@index([organizationId])
  @@index([poolId])
  @@index([follower])
  @@index([followTime])
  @@index([phone])
  @@index([reasonId])
  @@map("clue")
}

model ClueField {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.VarChar(255)

  resource Clue @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId, fieldId, fieldValue])
  @@map("clue_field")
}

model ClueFieldBlob {
  id         String @id @default(cuid()) @db.VarChar(32)
  resourceId String @map("resource_id") @db.VarChar(32)
  fieldId    String @map("field_id") @db.VarChar(32)
  fieldValue String @map("field_value") @db.Text

  resource Clue @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, fieldId])
  @@index([resourceId])
  @@map("clue_field_blob")
}

model ClueOwner {
  id             String  @id @default(cuid()) @db.VarChar(32)
  clueId         String  @map("clue_id") @db.VarChar(32)
  owner          String  @db.VarChar(32)
  collectionTime BigInt  @map("collection_time")
  endTime        BigInt  @map("end_time")
  operator       String  @db.VarChar(32)
  reasonId       String? @map("reason_id") @db.VarChar(32)

  clue Clue @relation(fields: [clueId], references: [id], onDelete: Cascade)

  @@index([clueId])
  @@map("clue_owner")
}

model CluePool {
  id             String  @id @default(cuid()) @db.VarChar(32)
  name           String  @db.VarChar(255)
  scopeId        String  @map("scope_id") @db.Text
  organizationId String  @map("organization_id") @db.VarChar(32)
  ownerId        String  @map("owner_id") @db.Text
  enable         Boolean @default(true)
  auto           Boolean @default(false)
  createTime     BigInt  @map("create_time")
  updateTime     BigInt  @map("update_time")
  createUser     String  @map("create_user") @db.VarChar(32)
  updateUser     String  @map("update_user") @db.VarChar(32)

  clues        Clue[]
  hiddenFields CluePoolHiddenField[]
  pickRule     CluePoolPickRule?
  recycleRule  CluePoolRecycleRule?

  @@index([organizationId])
  @@map("clue_pool")
}

model CluePoolHiddenField {
  poolId  String @map("pool_id") @db.VarChar(32)
  fieldId String @map("field_id") @db.VarChar(255)

  pool CluePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, fieldId])
  @@map("clue_pool_hidden_field")
}

model CluePoolPickRule {
  id               String  @id @default(cuid()) @db.VarChar(32)
  poolId           String  @unique @map("pool_id") @db.VarChar(32)
  limitOnNumber    Boolean @default(true) @map("limit_on_number")
  pickNumber       Int?    @map("pick_number")
  limitPreOwner    Boolean @default(true) @map("limit_pre_owner")
  pickIntervalDays Int?    @map("pick_interval_days")
  limitNew         Boolean @default(false) @map("limit_new")
  newPickInterval  Int?    @map("new_pick_interval")
  createUser       String  @map("create_user") @db.VarChar(32)
  createTime       BigInt  @map("create_time")
  updateUser       String  @map("update_user") @db.VarChar(32)
  updateTime       BigInt  @map("update_time")

  pool CluePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("clue_pool_pick_rule")
}

model CluePoolRecycleRule {
  id         String  @id @default(cuid()) @db.VarChar(32)
  poolId     String  @unique @map("pool_id") @db.VarChar(32)
  operator   String? @db.VarChar(10)
  condition  String? @db.Text
  createTime BigInt  @map("create_time")
  updateTime BigInt  @map("update_time")
  createUser String  @map("create_user") @db.VarChar(32)
  updateUser String  @map("update_user") @db.VarChar(32)

  pool CluePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("clue_pool_recycle_rule")
}

model ClueCapacity {
  id             String @id @default(cuid()) @db.VarChar(32)
  organizationId String @map("organization_id") @db.VarChar(32)
  scopeId        String @map("scope_id") @db.Text
  capacity       Int?
  createTime     BigInt @map("create_time")
  updateTime     BigInt @map("update_time")
  createUser     String @map("create_user") @db.VarChar(32)
  updateUser     String @map("update_user") @db.VarChar(32)

  @@index([organizationId])
  @@map("clue_capacity")
}

// ============ Cordys 系统字典：移池原因 / 失败原因等模块配置 ============

model SysDict {
  id             String @id @default(cuid()) @db.VarChar(32)
  name           String @db.VarChar(255)
  module         String @db.VarChar(20)
  type           String @default("TEXT") @db.VarChar(10)
  pos            BigInt
  organizationId String @map("organization_id") @db.VarChar(32)
  createTime     BigInt @map("create_time")
  updateTime     BigInt @map("update_time")
  createUser     String @map("create_user") @db.VarChar(32)
  updateUser     String @map("update_user") @db.VarChar(32)

  @@index([organizationId, module, pos])
  @@index([organizationId, name])
  @@map("sys_dict")
}

model SysDictConfig {
  module         String  @db.VarChar(20)
  organizationId String  @map("organization_id") @db.VarChar(32)
  enabled        Boolean @default(false)

  @@id([module, organizationId])
  @@map("sys_dict_config")
}

// ============ 跟进记录（多态：线索/客户/商机/合同） ============

model FollowUpRecord {
