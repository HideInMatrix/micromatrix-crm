        "description": "create table \"external_event_inbox\"",
        "sql": "CREATE TABLE \"public\".\"external_event_inbox\" (\n  \"api_key_user_id\" text NOT NULL,\n  \"attempts\" int4 DEFAULT 1 NOT NULL,\n  \"completed_at\" timestamptz(3),\n  \"customer_id\" text,\n  \"error_code\" text,\n  \"error_message\" text,\n  \"external_event_id\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"organization_id\" text NOT NULL,\n  \"received_at\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"request_hash\" text NOT NULL,\n  \"resolved_id\" text,\n  \"resolved_type\" text,\n  \"source\" text NOT NULL,\n  \"started_at\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"status\" text DEFAULT 'PROCESSING' NOT NULL,\n  \"updated_at\" timestamptz(3) NOT NULL,\n  CONSTRAINT \"external_event_inbox_pkey\" PRIMARY KEY (\"id\"),\n  CONSTRAINT \"eei_resolved_type_domain_rule_70bfae9d\" CHECK (\"resolved_type\" IS NULL OR \"resolved_type\" IN ('CUSTOMER','LEAD')),\n  CONSTRAINT \"eei_status_domain_rule_7683d47e\" CHECK (\"status\" IN ('PROCESSING','SUCCESS','FAILED')),\n  CONSTRAINT \"external_event_inbox_api_key_user_id_len_4cd2417e\" CHECK (char_length(\"api_key_user_id\") <= 32),\n  CONSTRAINT \"external_event_inbox_customer_id_len_98c57c01\" CHECK (char_length(\"customer_id\") <= 32),\n  CONSTRAINT \"external_event_inbox_error_code_len_b877baec\" CHECK (char_length(\"error_code\") <= 100),\n  CONSTRAINT \"external_event_inbox_error_message_len_808566f9\" CHECK (char_length(\"error_message\") <= 2000),\n  CONSTRAINT \"external_event_inbox_external_event_id_len_40c71264\" CHECK (char_length(\"external_event_id\") <= 200),\n  CONSTRAINT \"external_event_inbox_organization_id_len_0ac99d67\" CHECK (char_length(\"organization_id\") <= 32),\n  CONSTRAINT \"external_event_inbox_request_hash_len_3f9094fd\" CHECK (char_length(\"request_hash\") = 64),\n  CONSTRAINT \"external_event_inbox_resolved_id_len_c4e1f55c\" CHECK (char_length(\"resolved_id\") <= 32),\n  CONSTRAINT \"external_event_inbox_source_len_060042c0\" CHECK (char_length(\"source\") <= 100)\n)",
