# PostgreSQL 连接串（与根目录 docker-compose.yml 对应）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/default?schema=public"

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必更换为强随机值）
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PC 端企业微信通用登录入口默认企业（多租户部署必须明确配置）
WECOM_DEFAULT_TENANT_SLUG=demo

# 企业集成凭据加密密钥（生产环境必须设置独立随机值，至少 32 个字符）
INTEGRATION_CREDENTIALS_KEY="dev_integration_credentials_key_change_me_32_chars"
