# PostgreSQL 连接串（与根目录 docker-compose.yml 对应）
DATABASE_URL="postgresql://crm:crm@localhost:5432/micromatrix_crm?schema=public"

# 服务端口
PORT=3000

# JWT 密钥（生产环境务必更换为强随机值）
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
