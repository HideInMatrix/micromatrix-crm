{
  "name": "micromatrix-crm",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "build": "pnpm --filter @micromatrix/shared build && pnpm --filter @micromatrix/frontend-shared typecheck && pnpm --filter @micromatrix/api build && pnpm --filter @micromatrix/web build && pnpm --filter @micromatrix/mobile build",
    "typecheck": "pnpm --filter @micromatrix/shared build && pnpm --filter @micromatrix/shared typecheck && pnpm --filter @micromatrix/frontend-shared typecheck && pnpm --filter @micromatrix/api typecheck && pnpm --filter @micromatrix/web typecheck && pnpm --filter @micromatrix/mobile typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "smoke:docker-release": "bash docker/release-smoke.sh",
    "prisma:generate": "pnpm --filter @micromatrix/api prisma:generate",
    "db:migrate": "pnpm --filter @micromatrix/api prisma:deploy",
    "db:deploy": "pnpm --filter @micromatrix/api prisma:deploy",
    "db:migrate:dev": "pnpm --filter @micromatrix/api prisma:migrate",
    "db:status": "pnpm --filter @micromatrix/api prisma:status",
    "db:legacy-sync": "pnpm --filter @micromatrix/api prisma:legacy-sync",
    "db:verify-migrations": "node docker/verify-prisma-migrations.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
