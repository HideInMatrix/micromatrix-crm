{
  "name": "micromatrix-crm",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @micromatrix/shared build && pnpm --filter @micromatrix/api build && pnpm --filter @micromatrix/web build",
    "typecheck": "pnpm --filter @micromatrix/shared build && pnpm --filter @micromatrix/shared typecheck && pnpm --filter @micromatrix/api typecheck && pnpm --filter @micromatrix/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prisma:generate": "pnpm --filter @micromatrix/api prisma:generate",
    "db:migrate": "pnpm --filter @micromatrix/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @micromatrix/api exec prisma migrate dev",
    "smoke": "node scripts/smoke.mjs",
    "smoke:docker-release": "bash scripts/docker-release-smoke.sh",
    "smoke:enterprise-settings": "node scripts/enterprise-settings-smoke.mjs",
    "smoke:w341-home": "node scripts/w341-home-smoke.mjs",
    "smoke:w341-home-browser": "node scripts/w341-home-browser-smoke.mjs",
    "smoke:w342-clue-api": "node scripts/w342-clue-api-smoke.mjs",
    "smoke:w342-clue-transition": "node scripts/w342-clue-transition-smoke.mjs",
    "smoke:wecom-sync": "node scripts/wecom-sync-smoke.mjs",
    "smoke:wecom-sso-message": "node scripts/wecom-sso-message-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
