# 镜像版本：Git tag 推送后可使用 v0.0.1，也可直接指定完整镜像名覆盖 API_IMAGE / WEB_IMAGE。
APP_VERSION=v0.0.1

# 可选：fork 或私有镜像仓库时覆盖。
API_IMAGE=ghcr.io/hideinmatrix/micromatrix-crm-api:v0.0.1
WEB_IMAGE=ghcr.io/hideinmatrix/micromatrix-crm-web:v0.0.1

# PostgreSQL。默认 release compose 内置 postgres 服务；外部数据库可直接替换该 URL。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=default
DATABASE_URL=postgresql://postgres:change_me_postgres_password@postgres:5432/default?schema=public

# API 生产密钥，部署前必须替换。
JWT_ACCESS_SECRET=change_me_with_a_strong_random_access_secret
JWT_REFRESH_SECRET=change_me_with_a_strong_random_refresh_secret
INTEGRATION_CREDENTIALS_KEY=change_me_with_at_least_32_random_characters

# 对外 Web 地址及企微默认租户。
WEB_PUBLIC_URL=http://localhost:8080
WECOM_DEFAULT_TENANT_SLUG=demo
